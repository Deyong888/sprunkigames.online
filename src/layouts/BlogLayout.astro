---
import Container from "@components/container.astro";
import { getFormattedDate } from "@utils/all";
import Layout from "./Layout.astro";

const { frontmatter } = Astro.props;
---

<Layout title={frontmatter.title} description={frontmatter.snippet} image={frontmatter.image.src}>
  <Container>
    <div class="mx-auto max-w-[840px] mt-14 blog-hero">
      <span class="blog-category">
        {frontmatter.category}
      </span>
      <h1
        class="blog-title">
        {frontmatter.title}
      </h1>
      <div class="blog-meta">
        <span>
          {frontmatter.author}
        </span>
        <span>•</span>
        <time datetime={frontmatter.publishDate}>
          {getFormattedDate(frontmatter.publishDate)}
        </time>
        <span class="meta-separator">•</span>
        <div class="meta-tags">
          {
            frontmatter.tags.map((tag) => (
              <span class="tag-chip">#{tag}</span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mx-auto prose prose-lg mt-8 blog-article">
      <slot />
    </div>
    <div class="blog-back">
      <a
        href="/blog"
        class="back-link"
        >← Back to GameList</a
      >
    </div>
  </Container>
</Layout>

<script slot="head" type="application/ld+json">
  {JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: Astro.site?.toString() || 'https://sprunkigames.online'
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: new URL('/blog', Astro.site).toString()
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: frontmatter.title,
        item: new URL(Astro.url.pathname, Astro.site).toString()
      }
    ]
  })}
  </script>

<style>
  .blog-hero {
    width: min(1100px, 100%);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: linear-gradient(135deg, rgba(20, 20, 30, 0.85), rgba(12, 12, 18, 0.9));
    border-radius: 28px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .blog-category {
    color: #7dd3fc;
    letter-spacing: 0.18em;
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: 600;
  }

  .blog-title {
    font-size: clamp(2.2rem, 3.5vw, 3.1rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0;
    color: #fff;
  }

  .blog-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    align-items: center;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.95rem;
  }

  .meta-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-chip {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background: rgba(66, 47, 94, 0.15);
    border: 1px solid rgba(124, 39, 243, 0.35);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .blog-article {
    width: min(1100px, 100%);
    max-width: none;
    background: linear-gradient(145deg, rgba(12, 12, 18, 0.92), rgba(20, 20, 32, 0.9));
    border-radius: 32px;
    padding: clamp(2rem, 5vw, 3.5rem);
    border: 1px solid rgba(255, 255, 255, 0.863);
    box-shadow: 0 35px 80px rgba(0, 0, 0, 0.55);
  }

  .blog-article :is(p, li) {
    color: rgba(243, 243, 255, 0.85);
  }

  .blog-article :is(h2, h3, h4) {
    color: #ffffff;
  }

  .blog-article a {
    color: #7dd3fc;
  }

  .blog-back {
    text-align: center;
    margin-top: 2.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.9rem 1.75rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    text-decoration: none;
    transition: var(--transition-base);
  }

  .back-link:hover {
    background: rgba(109, 93, 211, 0.2);
    border-color: rgba(109, 93, 211, 0.4);
  }

  @media (max-width: 768px) {
    .blog-hero {
      padding: 1.2rem;
    }

    .blog-title {
      font-size: 2.2rem;
    }

    .blog-article {
      padding: 1.5rem;
    }
  }
</style>
