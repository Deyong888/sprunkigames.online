---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import CookieConsent from "@components/CookieConsent.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource-variable/bricolage-grotesque";
import "../styles/global.css";
const GOOGLE_ANALYTICS_ID = import.meta.env.PUBLIC_GOOGLE_ANALYTICS_ID;

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedImageWithDomain = new URL("/sprunki-game.png", Astro.site).toString();

const { title, description, image } = Astro.props;

const makeTitle = title
  ? title + " | " + "Sprunki Game"
  : "Sprunki Game - Creative Music Game";
---

<!DOCTYPE html>
<html lang={Astro.currentLocale || 'en'}>
  <head>
    <!-- Montag Multitag ads (zone 299135) -->
    <script is:inline src="https://quge5.com/88/tag.min.js" data-zone="299135" async data-cfasync="false"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PZE18JFZZY"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PZE18JFZZY');
    </script>
    <script defer data-domain="sprunkigames.online" src="https://analytics.24kwebgames.com/js/script.outbound-links.js"></script>

    <SEO
      title={makeTitle}
      description={description ?? "Create amazing music with Sprunki! Mix beats, melodies & effects using unique characters. Free online music game inspired by Incredibox. No download required - play now in your browser!"}
      canonical={canonicalURL}
      twitter={{
        creator: "@sprunkigame",
        site: "@sprunkigame",
        card: "summary_large_image",
        title: makeTitle,
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: makeTitle,
          image: image ? new URL(image, Astro.site).toString() : resolvedImageWithDomain,
        },
        image: {
          alt: "Sprunki Game Homepage Screenshot",
        },
      }}
    />
    <slot name="head" />
    <script type="application/ld+json">
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        url: Astro.site?.toString() || 'https://sprunkigames.online',
        name: 'Sprunki Game',
        inLanguage: Astro.currentLocale || 'en',
        publisher: {
          '@type': 'Organization',
          name: 'Sprunki Game',
          url: Astro.site?.toString() || 'https://sprunkigames.online',
          logo: new URL('/favicon.svg', Astro.site).toString(),
        }
      })}
    </script>
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Synthflow Digital LTD",
        "alternateName": "Sprunki Games",
        "url": Astro.site?.toString() || "https://sprunkigames.online",
        "logo": new URL("/sprunki-game.png", Astro.site).toString(),
        "email": "support@synthflowdigital.com",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Office 16430, 182-184 High Street North",
          "addressLocality": "East Ham, London",
          "postalCode": "E6 2JA",
          "addressCountry": "UK"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "support@synthflowdigital.com",
          "contactType": "customer support",
          "availableLanguage": ["English", "Chinese", "Spanish", "Filipino"]
        },
        "sameAs": [
          "https://twitter.com/sprunkigame"
        ]
      })}
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/artalk/2.9.1/Artalk.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/artalk/2.9.1/Artalk.js"></script>
  </head>
  <body class="site-body">
    <div class="noise-overlay" aria-hidden="true"></div>
    <Navbar />
    <main class="site-main">
      <slot />
    </main>
    <Footer />
    <CookieConsent locale={Astro.currentLocale || 'en'} />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
