---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
import Gameplay from '../components/Gameplay.astro';
import Gamelist from '../components/Gamelist.astro';
import Features from "../components/features.astro";
import HowToPlay from "../components/howtoplay.astro";
import SocialShare from "../components/SocialShare.astro";
import Faq from "../components/FAQ.astro";
import Videos from "../components/Videos.astro";
import Bloglist from "../components/Bloglist.astro";
import Cta from "../components/cta.astro";

const locale = Astro.currentLocale || 'en';
---

<Layout title="Sprunki Game">
  <Container>
    <Gameplay locale={locale} id="Gameplay" />
    <Gamelist locale={locale} />
    <SocialShare locale={locale} />
    <Videos locale={locale} />
    <HowToPlay locale={locale} />
    <Features locale={locale}/>
    <Faq locale={locale} />
    <Bloglist locale={locale} />
    <Cta />
  </Container>
</Layout>
