---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
import Gameplay from '../components/Gameplay.astro';
import Gamelist from '../components/Gamelist.astro';
import Features from "../components/features.astro";
import HowToPlay from "../components/howtoplay.astro";
import SocialShare from "../components/SocialShare.astro";
import Faq from "../components/FAQ.astro";
import Videos from "../components/Videos.astro";
import Bloglist from "../components/Bloglist.astro";
import Cta from "../components/cta.astro";

const locale = Astro.currentLocale || 'en';
---

<Layout title="Sprunki Game">
  <script slot="head" type="application/ld+json">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoGame",
      "name": "Subway Surfers",
      "url": "https://subwaysurfersgame.run",
      "image": "https://subwaysurfersgame.run/assets/cover.jpg",
      "description": "Play the original Subway Surfers online directly in your browser. Dash as fast as you can!",
      "genre": ["Endless Runner", "Action"],
      "gamePlatform": ["Web Browser", "PC", "Mobile"],
      "applicationCategory": "Game",
      "operatingSystem": "Any",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "15024",
        "bestRating": "5",
        "worstRating": "1"
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD",
        "category": "free"
      }
    })}
  </script>
  <Gameplay locale={locale} id="Gameplay" />
  <Container>
    <Gamelist locale={locale} />
    <SocialShare locale={locale} />
    <Bloglist locale={locale} />
    <HowToPlay locale={locale} />
    <Videos locale={locale} />
    <Features locale={locale}/>
    <Faq locale={locale} />
    <Cta />
  </Container>
</Layout>
