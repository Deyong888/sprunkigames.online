---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";

const { locale = 'en' } = Astro.props;

// 多语言翻译
const translations = {
  en: {
    title: "Sprunki Horror - The Dark Side of Music Creation",
    desc: "Experience the chilling world of Sprunki Horror. Dark characters, eerie sounds, and spine-tingling music creation await. Not for the faint of heart!",
    intro: "What is Sprunki Horror?",
    introDesc: "Sprunki Horror transforms the cheerful music creation experience into a dark, atmospheric journey. Featuring horror-themed characters with distorted sounds and unsettling visuals, this mod creates haunting melodies that send shivers down your spine.",
    features: "Key Features",
    feature1: "Dark Characters",
    feature1Desc: "Meet twisted versions of your favorite Sprunki characters with haunting new designs",
    feature2: "Eerie Soundscapes",
    feature2Desc: "Create music with distorted beats, ghostly whispers, and unsettling effects",
    feature3: "Horror Atmosphere",
    feature3Desc: "Immersive dark visual themes that enhance the spooky music creation experience",
    howToPlay: "How to Play Sprunki Horror",
    step1: "Select a Horror Character",
    step1Desc: "Choose from the twisted roster of dark Sprunki characters",
    step2: "Create Dark Melodies",
    step2Desc: "Layer eerie sounds to craft haunting compositions",
    step3: "Share Your Creation",
    step3Desc: "Save and share your spine-chilling musical masterpieces",
    relatedGames: "Related Horror Games",
    playNow: "Play Now",
    warning: "Warning: This version contains dark themes and may be scary for some users",
    ctaTitle: "Ready to Face the Darkness?",
    ctaButton: "Play Sprunki Horror"
  },
  zh: {
    title: "Sprunki恐怖版 - 音乐创作的黑暗面",
    desc: "体验令人毛骨悚然的Sprunki恐怖世界。黑暗角色、诡异音效、令人战栗的音乐创作等待着你。胆小者慎入！",
    intro: "什么是Sprunki恐怖版？",
    introDesc: "Sprunki恐怖版将欢快的音乐创作体验转变为黑暗、氛围化的旅程。 featuring恐怖主题的角色，带有扭曲的音效和令人不安的视觉效果，这个模组创造出令人毛骨悚然的旋律，让你脊背发凉。",
    features: "核心特色",
    feature1: "黑暗角色",
    feature1Desc: "认识扭曲版的Sprunki角色，带有令人难忘的新设计",
    feature2: "诡异音景",
    feature2Desc: "使用扭曲的节拍、幽灵般的低语和令人不安的效果创作音乐",
    feature3: "恐怖氛围",
    feature3Desc: "沉浸式的黑暗视觉主题，增强恐怖的音乐创作体验",
    howToPlay: "如何玩Sprunki恐怖版",
    step1: "选择恐怖角色",
    step1Desc: "从扭曲的黑暗Sprunki角色阵容中选择",
    step2: "创作黑暗旋律",
    step2Desc: "叠加诡异的音效，打造令人难忘的作曲",
    step3: "分享你的作品",
    step3Desc: "保存并分享你令人脊背发凉的音乐杰作",
    relatedGames: "相关恐怖游戏",
    playNow: "立即游玩",
    warning: "警告：此版本包含黑暗主题，可能对某些用户造成惊吓",
    ctaTitle: "准备好面对黑暗了吗？",
    ctaButton: "玩Sprunki恐怖版"
  },
  es: {
    title: "Sprunki Horror - El Lado Oscuro de la Creación Musical",
    desc: "Experimenta el escalofriante mundo de Sprunki Horror. Personajes oscuros, sonidos inquietantes y creación musical espeluznante te esperan. ¡No para cardíacos!",
    intro: "¿Qué es Sprunki Horror?",
    introDesc: "Sprunki Horror transforma la alegre experiencia de creación musical en un viaje oscuro y atmosférico. Con personajes de temática de terror con sonidos distorsionados y visuales inquietantes, este mod crea melodías inquietantes que te ponen la piel de gallina.",
    features: "Características Principales",
    feature1: "Personajes Oscuros",
    feature1Desc: "Conoce versiones retorcidas de tus personajes favoritos de Sprunki",
    feature2: "Paisajes Sonoros Inquietantes",
    feature2Desc: "Crea música con ritmos distorsionados, susurros fantasmales y efectos inquietantes",
    feature3: "Atmósfera de Terror",
    feature3Desc: "Temas visuales oscuros inmersivos que mejoran la experiencia de creación musical",
    howToPlay: "Cómo Jugar Sprunki Horror",
    step1: "Selecciona un Personaje de Terror",
    step1Desc: "Elige entre el elenco retorcido de personajes oscuros de Sprunki",
    step2: "Crea Melodías Oscuras",
    step2Desc: "Superpone sonidos inquietantes para crear composiciones espeluznantes",
    step3: "Comparte tu Creación",
    step3Desc: "Guarda y comparte tus obras musicales de terror",
    relatedGames: "Juegos de Terror Relacionados",
    playNow: "Jugar Ahora",
    warning: "Advertencia: Esta versión contiene temas oscuros y puede asustar a algunos usuarios",
    ctaTitle: "¿Listo para Enfrentar la Oscuridad?",
    ctaButton: "Jugar Sprunki Horror"
  },
  fil: {
    title: "Sprunki Horror - Ang Madilim na Bahagi ng Paglikha ng Musika",
    desc: "Maranasan ang nakakatakot na mundo ng Sprunki Horror. Madilim na mga karakter, nakatatakot na mga tunog, at nakakakilabot na paglikha ng musika ang naghihintay. Hindi para sa mga duwag!",
    intro: "Ano ang Sprunki Horror?",
    introDesc: "Ang Sprunki Horror ay nagbabago sa masayang karanasan sa paglikha ng musika sa isang madilim, atmospheric na paglalakbay. Na may mga karakter na may temang horror na may distorsiyon na mga tunog at nakakabahalang visuals, ang mod na ito ay lumilikha ng mga nakakatakot na melody.",
    features: "Pangunahing Mga Tampok",
    feature1: "Madilim na mga Karakter",
    feature1Desc: "Kilalanin ang mga baluktot na bersyon ng iyong paboritong mga karakter sa Sprunki",
    feature2: "Nakakatakot na Soundscapes",
    feature2Desc: "Lumikha ng musika na may distorsiyon na beats, mga hibik ng multo, at nakakabahalang effects",
    feature3: "Atmosphere ng Horror",
    feature3Desc: "Immersive na madilim na visual themes na nagpapahusay sa nakakatakot na karanasan",
    howToPlay: "Paano Maglaro ng Sprunki Horror",
    step1: "Pumili ng Karakter ng Horror",
    step1Desc: "Pumili mula sa baluktot na roster ng madilim na mga karakter sa Sprunki",
    step2: "Lumikha ng Madilim na Melodies",
    step2Desc: "Maglagay ng mga nakatatakot na tunog para lumikha ng nakakakilabot na compositions",
    step3: "Ibahagi ang Iyong Creation",
    step3Desc: "I-save at ibahagi ang iyong mga nakakakilabot na obra maestra sa musika",
    relatedGames: "Mga Kaugnay na Laro ng Horror",
    playNow: "Maglaro Ngayon",
    warning: "Babala: Ang bersyon na ito ay naglalaman ng madilim na tema at maaaring nakakatakot sa ilang users",
    ctaTitle: "Handa nang Harapin ang Kadiliman?",
    ctaButton: "Maglaro ng Sprunki Horror"
  }
};

const t = translations[locale] || translations.en;

// 相关恐怖游戏
const horrorGames = [
  {
    id: "sprunki-horror",
    title: "Sprunki Horror",
    image: "https://img.gamepix.com/games/sprunki-horror/icon/sprunki-horror.png?w=105",
    url: "https://play.gamepix.com/sprunki-horror/embed?sid=1",
    description: locale === 'zh' ? "经典恐怖版本" : locale === 'es' ? "Versión clásica de horror" : locale === 'fil' ? "Klasikong bersyon ng horror" : "Classic horror version"
  },
  {
    id: "sprunki-squid-gaming",
    title: "Sprunki Squid Gaming",
    image: "https://img.gamepix.com/games/sprunki-squid-gaming/icon/sprunki-squid-gaming.png?w=105",
    url: "https://play.gamepix.com/sprunki-squid-gaming/embed?sid=1",
    description: locale === 'zh' ? "鱿鱼游戏联动版" : locale === 'es' ? "Versión Squid Game" : locale === 'fil' ? "Squid Game version" : "Squid Game crossover"
  },
  {
    id: "sprunki-find-tung-tung",
    title: "Sprunki Find Tung Tung Tung Sahur",
    image: "https://img.gamepix.com/games/sprunki-find-tung-tung-tung-sahur/icon/sprunki-find-tung-tung-tung-sahur.png?w=105",
    url: "https://play.gamepix.com/sprunki-find-tung-tung-tung-sahur/embed?sid=1",
    description: locale === 'zh' ? "解谜恐怖游戏" : locale === 'es' ? "Juego de terror puzzle" : locale === 'fil' ? "Puzzle horror game" : "Puzzle horror game"
  },
  {
    id: "sprunki-squid-anomaly",
    title: "Squid Game x Sprunki Anomaly",
    image: "https://img.gamepix.com/games/squid-game-x-sprunki-anomaly/icon/squid-game-x-sprunki-anomaly.png?w=105",
    url: "https://play.gamepix.com/squid-game-x-sprunki-anomaly/embed?sid=1",
    description: locale === 'zh' ? "异常恐怖版" : locale === 'es' ? "Versión anomalía" : locale === 'fil' ? "Bersyon anomaly" : "Anomaly version"
  }
];

// Schema.org structured data
const videoGameSchema = {
  "@context": "https://schema.org",
  "@type": "VideoGame",
  "name": "Sprunki Horror",
  "description": t.desc,
  "url": "https://sprunkigames.online/horror",
  "genre": ["Music", "Horror", "Casual"],
  "gamePlatform": ["Web Browser", "PC", "Mobile", "Tablet"],
  "applicationCategory": "Game",
  "operatingSystem": "Any",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "author": {
    "@type": "Organization",
    "name": "Synthflow Digital LTD"
  },
  "isPartOf": {
    "@type": "VideoGame",
    "name": "Sprunki Game"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": locale === 'zh' ? '首页' : locale === 'es' ? 'Inicio' : locale === 'fil' ? 'Home' : 'Home',
      "item": "https://sprunkigames.online"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.title,
      "item": `https://sprunkigames.online/${locale === 'en' ? '' : locale + '/'}horror`
    }
  ]
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": horrorGames.map((game, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": game.title,
    "description": game.description,
    "url": game.url
  }))
};
---

<Layout title={t.title} description={t.desc}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(videoGameSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(itemListSchema)} />
  
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t.title}</Fragment>
      <Fragment slot="desc">{t.desc}</Fragment>
    </Sectionhead>

    <main class="mt-16">
      <!-- Warning Banner -->
      <div class="warning-banner">
        <svg class="warning-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
        <p class="warning-text">{t.warning}</p>
      </div>

      <!-- Introduction -->
      <section class="intro-section">
        <h2 class="section-title">{t.intro}</h2>
        <p class="intro-text">{t.introDesc}</p>
      </section>

      <!-- Features -->
      <section class="features-section">
        <h2 class="section-title">{t.features}</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">👻</div>
            <h3 class="feature-title">{t.feature1}</h3>
            <p class="feature-desc">{t.feature1Desc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🎵</div>
            <h3 class="feature-title">{t.feature2}</h3>
            <p class="feature-desc">{t.feature2Desc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🌑</div>
            <h3 class="feature-title">{t.feature3}</h3>
            <p class="feature-desc">{t.feature3Desc}</p>
          </div>
        </div>
      </section>

      <!-- How to Play -->
      <section class="how-to-section">
        <h2 class="section-title">{t.howToPlay}</h2>
        <div class="steps-container">
          <div class="step-item">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3 class="step-title">{t.step1}</h3>
              <p class="step-desc">{t.step1Desc}</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3 class="step-title">{t.step2}</h3>
              <p class="step-desc">{t.step2Desc}</p>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3 class="step-title">{t.step3}</h3>
              <p class="step-desc">{t.step3Desc}</p>
            </div>
          </div>
        </div>
      </section>

      <!-- Related Games -->
      <section class="games-section">
        <h2 class="section-title">{t.relatedGames}</h2>
        <div class="games-grid">
          {horrorGames.map((game, index) => (
            <div class="game-card">
              <div class="game-image-wrapper">
                <img 
                  src={game.image} 
                  alt={game.title}
                  class="game-image"
                  loading={index < 2 ? "eager" : "lazy"}
                  width="200"
                  height="200"
                />
                <span class="game-badge">Horror</span>
              </div>
              <div class="game-content">
                <h3 class="game-title">{game.title}</h3>
                <p class="game-description">{game.description}</p>
                <a 
                  href={game.url} 
                  class="play-button"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" />
                  </svg>
                  {t.playNow}
                </a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- CTA -->
      <div class="cta-section">
        <h2 class="cta-title">{t.ctaTitle}</h2>
        <a href="https://play.gamepix.com/sprunki-horror/embed?sid=1" class="cta-button" target="_blank" rel="noopener noreferrer">
          {t.ctaButton}
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </main>
  </Container>
</Layout>

<style>
  .warning-banner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.15) 0%, rgba(220, 38, 38, 0.05) 100%);
    border: 1px solid rgba(220, 38, 38, 0.3);
    border-radius: 12px;
    margin-bottom: 3rem;
  }

  .warning-icon {
    width: 24px;
    height: 24px;
    color: #EF4444;
    flex-shrink: 0;
  }

  .warning-text {
    color: #FCA5A5;
    font-size: 0.95rem;
    margin: 0;
  }

  .intro-section {
    max-width: 800px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .intro-text {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .features-section {
    margin-bottom: 4rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .feature-card {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.08) 0%, rgba(127, 90, 240, 0.03) 100%);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 20px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .feature-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
    transform: translateY(-4px);
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .feature-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0 0 0.75rem 0;
  }

  .feature-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .how-to-section {
    margin-bottom: 4rem;
  }

  .steps-container {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .step-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    transition: all 0.3s ease;
  }

  .step-item:hover {
    border-color: rgba(139, 92, 246, 0.3);
  }

  .step-number {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #DC2626 0%, #EF4444 100%);
    color: white;
    font-weight: 700;
    font-size: 1.25rem;
    border-radius: 12px;
    flex-shrink: 0;
  }

  .step-content {
    flex: 1;
  }

  .step-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0 0 0.5rem 0;
  }

  .step-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .games-section {
    margin-bottom: 4rem;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .games-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .game-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .game-card:hover {
    border-color: rgba(220, 38, 38, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(220, 38, 38, 0.15);
  }

  .game-image-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  }

  .game-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    transition: transform 0.3s ease;
  }

  .game-card:hover .game-image {
    transform: scale(1.05);
  }

  .game-badge {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 0.25rem 0.5rem;
    background: linear-gradient(135deg, #DC2626 0%, #EF4444 100%);
    color: white;
    font-size: 0.625rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
  }

  .game-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .game-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-heading);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .game-description {
    font-size: 0.75rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .play-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, #DC2626 0%, #EF4444 100%);
    color: white;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: 0.5rem;
    border: none;
    cursor: pointer;
  }

  .play-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(220, 38, 38, 0.4);
  }

  .cta-section {
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.1) 0%, rgba(139, 92, 246, 0.05) 100%);
    border-radius: 24px;
    border: 1px solid rgba(220, 38, 38, 0.2);
  }

  .cta-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-heading);
    margin-bottom: 1.5rem;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    background: linear-gradient(135deg, #DC2626 0%, #EF4444 100%);
    color: white;
    border-radius: 50px;
