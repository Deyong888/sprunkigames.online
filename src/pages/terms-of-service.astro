const t = translations[locale] || translations.en;
---

<Layout title={t.meta.title} description={t.meta.description}>
  <div class="terms-page">
    <div class="container mx-auto px-4 py-12 max-w-4xl">
      <h1 class="heading-gradient text-center mb-4">
        {t.title}
      </h1>
      <p class="text-center text-gray-600 mb-4">
        {t.lastUpdated}
      </p>
      <div class="prose prose-lg text-gray-700 mb-12 bg-white/50 p-6 rounded-lg">
        {t.intro}
      </div>

      <div class="space-y-12">
        {t.sections.map((section) => (
          <section class="terms-section">
            <h2 class="text-2xl font-bold text-[#6B48FF] mb-4">
              {section.title}
            </h2>
            <div class="prose prose-lg text-gray-600 whitespace-pre-line">
              {section.content}
            </div>
          </section>
        ))}
      </div>
    </div>
  </div>
</Layout>

<style>
  .terms-page {
    background: linear-gradient(135deg, rgba(255, 97, 216, 0.1), rgba(107, 72, 255, 0.1));
  }

  .heading-gradient {
    font-size: 2.5rem;
    font-weight: bold;
    background: linear-gradient(to right, #FF61D8, #6B48FF);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .terms-section {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 16px;
    padding: 2rem;
    border: 2px solid rgba(255, 97, 216, 0.1);
    transition: all 0.3s ease;
  }

  .terms-section:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(107, 72, 255, 0.1);
  }

  @media (max-width: 768px) {
    .heading-gradient {
      font-size: 2rem;
    }

    .terms-section {
      padding: 1.5rem;
    }
  }
</style>
