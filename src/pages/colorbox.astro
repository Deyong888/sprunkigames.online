    colorEditions: "Ediciones de Color Disponibles",
    redTitle: "Colorbox Rojo",
    redDesc: "Ritmos cálidos y energéticos con melodías apasionadas",
    yellowTitle: "Colorbox Amarillo",
    yellowDesc: "Tonos brillantes y alegres con disposición soleada",
    blueTitle: "Colorbox Azul",
    blueDesc: "Ritmos frescos y calmados con armonías serenas",
    greenTitle: "Colorbox Verde",
    greenDesc: "Sonidos naturales y orgánicos con vibras terrosas",
    howToPlay: "Cómo Jugar Colorbox",
    step1: "Elige Tu Color",
    step1Desc: "Selecciona una edición Colorbox que coincida con tu estado de ánimo creativo",
    step2: "Mezcla Colores y Sonidos",
    step2Desc: "Combina diferentes personajes de color para paletas musicales únicas",
    step3: "Crea Música Vibrante",
    step3Desc: "Superpone sonidos para crear composiciones musicales cromáticas",
    relatedGames: "Juegos Colorbox Relacionados",
    playNow: "Jugar Ahora",
    ctaTitle: "¿Listo para Agregar Color a tu Música?",
