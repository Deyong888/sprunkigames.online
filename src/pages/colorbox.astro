  },
  es: {
    title: "Sprunki Colorbox - Experiencia Vibrante de Creación Musical",
    desc: "Descubre el colorido mundo de Sprunki Colorbox. Crea música vibrante con personajes temáticos de colores, combinaciones de sonido frescas y estilos visuales impresionantes.",
    intro: "¿Qué es Sprunki Colorbox?",
    introDesc: "Sprunki Colorbox es una variante vibrante y temática de colores del clásico juego de creación musical Sprunki. Cada edición de color trae estilos visuales únicos y combinaciones de sonido frescas, permitiendo a los creadores crear música con un toque cromático distintivo.",
    features: "Características de Colorbox",
    feature1: "Personajes Temáticos de Color",
    feature1Desc: "Cada edición presenta personajes diseñados alrededor de paletas de colores específicas",
    feature2: "Perfiles de Sonido Únicos",
