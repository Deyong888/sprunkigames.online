---
import Contactform from "@components/contactform.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Layout from "@layouts/Layout.astro";
import { Icon } from "astro-icon/components";
---

<Layout title="Contact Us - Sprunki Game | Synthflow Digital LTD" description="Contact Synthflow Digital LTD, the company behind Sprunki Game. Get support, report issues, or send feedback.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Contact Us</Fragment>
      <Fragment slot="desc">We are here to help. Get in touch with our team.</Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800 mb-4">Contact Sprunki Game</h2>
        <p class="text-lg leading-relaxed text-slate-500 mb-6">
          Have a question, suggestion, or need assistance? We are here to help. Fill out the form or reach out to us directly using the contact information below.
        </p>
        
        <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-6 mb-6">
          <h3 class="font-semibold text-lg text-gray-800 mb-4">Company Information</h3>
          <div class="space-y-3">
            <div class="flex items-center space-x-2 text-gray-600">
              <Icon class="text-purple-500 w-5 h-5" name="uil:building" />
              <span class="font-medium">Synthflow Digital LTD</span>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <h3 class="font-semibold text-lg text-gray-800">Contact Details</h3>
          
          <div class="flex items-start space-x-3 text-gray-600">
            <Icon class="text-gray-400 w-5 h-5 mt-0.5" name="uil:map-marker" />
            <div>
              <p class="font-medium">Registered Address:</p>
              <p class="text-sm">Office 16430</p>
              <p class="text-sm">182-184 High Street North</p>
              <p class="text-sm">East Ham, London, E6 2JA</p>
              <p class="text-sm">United Kingdom</p>
            </div>
          </div>
          
          <div class="flex items-center space-x-3 text-gray-600">
            <Icon class="text-gray-400 w-5 h-5" name="uil:envelope" />
            <div>
              <span class="font-medium">Email: </span>
              <a href="mailto:support@synthflowdigital.com" class="text-purple-600 hover:text-purple-800 transition-colors">
                support@synthflowdigital.com
              </a>
            </div>
          </div>
          
          <div class="flex items-center space-x-3 text-gray-600">
            <Icon class="text-gray-400 w-5 h-5" name="uil:globe" />
            <div>
              <span class="font-medium">Website: </span>
              <a href="https://sprunkigames.online" class="text-purple-600 hover:text-purple-800 transition-colors">
                sprunkigames.online
              </a>
            </div>
          </div>
        </div>

        <div class="mt-8 p-4 bg-blue-50 rounded-lg border border-blue-100">
          <p class="text-sm text-blue-800">
            <Icon class="inline w-4 h-4 mr-1" name="uil:clock" />
            <span class="font-medium">Response Time:</span> We typically respond to all inquiries within 48 hours during business days.
          </p>
        </div>
      </div>
      <div>
        <Contactform />
      </div>
    </div>
  </Container>
</Layout>
