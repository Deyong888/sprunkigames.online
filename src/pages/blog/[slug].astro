---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
  <Container>
    <div class="blog-hero mx-auto mt-14">
      <span class="blog-category">
        {entry.data.category}
      </span>
      <h1 class="blog-title">
        {entry.data.title}
      </h1>
      <div class="blog-meta">
        <span>{entry.data.author}</span>
        <span>•</span>
        <time datetime={entry.data.publishDate.toISOString()}>
          {entry.data.publishDate.toDateString()}
        </time>
        <span class="meta-separator">•</span>
        <div class="meta-tags">
          {
            entry.data.tags.map((tag) => (
              <span class="tag-chip">#{tag}</span>
            ))
          }
        </div>
      </div>
    </div>

    <div class="blog-article mx-auto prose prose-lg mt-8">
      <Content />
    </div>

    <div class="blog-back">
      <a href="/blog" class="back-link">← Back to Blog</a>
    </div>

    <div class="comments-shell mx-auto">
      <div id="Comments"></div>
    </div>
  </Container>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // @ts-ignore
      Artalk.init({
        el: '#Comments',
        pageKey: window.location.pathname,
        pageTitle: document.title,
        server: 'https://data.24kwebgames.com',
        site: 'Sprunki',

        avatarURLBuilder: (comment) => {
          if (comment.is_admin) {
            return "https://static.vecteezy.com/system/resources/thumbnails/027/951/137/small_2x/stylish-spectacles-guy-3d-avatar-character-illustrations-png.png";
          }
          return `https://cravatar.cn/avatar/${comment.email_encrypted}`;
        }
      });
    });
  </script>
  <style>
    .blog-hero {
    width: min(1100px, 100%);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
      padding: clamp(1.5rem, 4vw, 2.5rem);
      background: linear-gradient(135deg, rgba(20, 20, 30, 0.85), rgba(12, 12, 18, 0.9));
      border-radius: 28px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
    }

    .blog-category {
      color: #7dd3fc;
      letter-spacing: 0.18em;
      font-size: 0.8rem;
      text-transform: uppercase;
      font-weight: 600;
    }

    .blog-title {
      font-size: clamp(2.2rem, 3.5vw, 3.1rem);
      font-weight: 800;
      line-height: 1.15;
      margin: 0;
      color: #fff;
    }

    .blog-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.65rem;
      align-items: center;
      color: rgba(255, 255, 255, 0.75);
      font-size: 0.95rem;
    }

    .meta-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .tag-chip {
      padding: 0.3rem 0.75rem;
      border-radius: 999px;
      background: rgba(143, 90, 218, 0.15);
      border: 1px solid rgba(143, 90, 218, 0.35);
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.8);
    }

    .blog-article {
      width: min(1100px, 100%);
      max-width: none;
      background: linear-gradient(145deg, rgba(12, 12, 18, 0.92), rgba(20, 20, 32, 0.9));
      border-radius: 32px;
      padding: clamp(2rem, 5vw, 3.5rem);
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 35px 80px rgba(0, 0, 0, 0.55);
      color: rgba(243, 243, 255, 0.88);
    }

    .blog-article :is(p, li) {
      color: rgba(243, 243, 255, 0.88);
    }

    .blog-article :is(h2, h3, h4) {
      color: #ffffff;
    }

    .blog-article a {
      color: #7dd3fc;
    }

    .blog-back {
      text-align: center;
      margin-top: 2.5rem;
    }

    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.9rem 1.75rem;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.12);
      color: #fff;
      text-decoration: none;
      transition: var(--transition-base);
    }

    .back-link:hover {
      background: rgba(109, 93, 211, 0.2);
      border-color: rgba(109, 93, 211, 0.4);
    }

    .comments-shell {
    margin: 3rem auto 0;
    width: min(1000px, 100%);
      background: rgba(10, 10, 18, 0.85);
      border-radius: 24px;
      padding: 1.5rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.55);
    }

    @media (max-width: 768px) {
      .blog-hero {
        padding: 1.2rem;
      }

      .blog-title {
        font-size: 2.2rem;
      }

      .blog-article {
        padding: 1.5rem;
      }
    }

  .blog-article strong,
  .blog-article em {
    background: linear-gradient(120deg, #c084fc, #a855f7, #7c3aed);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-weight: 700;
  }
  </style>
</Layout>
