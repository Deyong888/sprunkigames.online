const t = translations[locale] || translations.en;

const guideSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": t.title,
  "description": t.desc,
  "step": [
    { "@type": "HowToStep", "name": t.step1Title, "text": t.step1Desc },
    { "@type": "HowToStep", "name": t.step2Title, "text": t.step2Desc },
    { "@type": "HowToStep", "name": t.step3Title, "text": t.step3Desc },
    { "@type": "HowToStep", "name": t.step4Title, "text": t.step4Desc }
  ]
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": locale === 'zh' ? '首页' : locale === 'es' ? 'Inicio' : locale === 'fil' ? 'Home' : 'Home', "item": "https://sprunkigames.online" },
    { "@type": "ListItem", "position": 2, "name": locale === 'zh' ? '教程' : locale === 'es' ? 'Tutorial' : locale === 'fil' ? 'Tutorial' : 'Tutorial', "item": "https://sprunkigames.online/tutorial" },
    { "@type": "ListItem", "position": 3, "name": t.heading, "item": `https://sprunkigames.online/${locale === 'en' ? '' : locale + '/'}guide/professional-beats` }
  ]
};
---

<Layout title={t.title} description={t.desc}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(guideSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t.heading}</Fragment>
      <Fragment slot="desc">{t.subheading}</Fragment>
    </Sectionhead>
    <main class="mt-16">
      <section class="guide-hero">
        <h2 class="section-title">{t.intro}</h2>
        <p class="intro-text">{t.introDesc}</p>
      </section>
      <section class="fundamentals-section">
        <h2 class="section-title">{t.fundamentals}</h2>
        <p class="section-desc">{t.fundamentalsDesc}</p>
        <div class="fundamentals-grid">
          <div class="fundamental-card">
            <div class="fundamental-icon">🥁</div>
            <h3>{t.fundamental1}</h3>
            <p>{t.fundamental1Desc}</p>
          </div>
          <div class="fundamental-card">
            <div class="fundamental-icon">🎵</div>
            <h3>{t.fundamental2}</h3>
            <p>{t.fundamental2Desc}</p>
          </div>
          <div class="fundamental-card">
            <div class="fundamental-icon">🔄</div>
            <h3>{t.fundamental3}</h3>
            <p>{t.fundamental3Desc}</p>
          </div>
        </div>
      </section>
      <section class="steps-section">
        <h2 class="section-title">4-Step Process</h2>
        <div class="steps-list">
          <div class="step-item">
            <div class="step-number">1</div>
            <div class="step-content">
              <h3>{t.step1Title}</h3>
              <p>{t.step1Desc}</p>
              <div class="step-tip">💡 {t.step1Tip}</div>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">2</div>
            <div class="step-content">
              <h3>{t.step2Title}</h3>
              <p>{t.step2Desc}</p>
              <div class="step-tip">💡 {t.step2Tip}</div>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">3</div>
            <div class="step-content">
              <h3>{t.step3Title}</h3>
              <p>{t.step3Desc}</p>
              <div class="step-tip">💡 {t.step3Tip}</div>
            </div>
          </div>
          <div class="step-item">
            <div class="step-number">4</div>
            <div class="step-content">
              <h3>{t.step4Title}</h3>
              <p>{t.step4Desc}</p>
              <div class="step-tip">💡 {t.step4Tip}</div>
            </div>
          </div>
        </div>
      </section>
      <section class="advanced-section">
        <h2 class="section-title">{t.advancedTitle}</h2>
        <div class="advanced-grid">
          <div class="advanced-card">
            <div class="advanced-icon">⬇️</div>
            <h3>{t.technique1}</h3>
            <p>{t.technique1Desc}</p>
          </div>
          <div class="advanced-card">
            <div class="advanced-icon">💓</div>
            <h3>{t.technique2}</h3>
            <p>{t.technique2Desc}</p>
          </div>
          <div class="advanced-card">
            <div class="advanced-icon">🎛️</div>
            <h3>{t.technique3}</h3>
            <p>{t.technique3Desc}</p>
          </div>
        </div>
      </section>
      <section class="mistakes-section">
        <h2 class="section-title">{t.mistakesTitle}</h2>
        <div class="mistakes-list">
          <div class="mistake-item">
            <span class="mistake-icon">❌</span>
            <div class="mistake-content">
              <h3>{t.mistake1}</h3>
              <p>{t.mistake1Desc}</p>
            </div>
          </div>
          <div class="mistake-item">
            <span class="mistake-icon">📉</span>
            <div class="mistake-content">
              <h3>{t.mistake2}</h3>
              <p>{t.mistake2Desc}</p>
            </div>
          </div>
          <div class="mistake-item">
            <span class="mistake-icon">🔉</span>
            <div class="mistake-content">
              <h3>{t.mistake3}</h3>
              <p>{t.mistake3Desc}</p>
            </div>
          </div>
        </div>
      </section>
      <section class="checklist-section">
        <h2 class="section-title">{t.checklistTitle}</h2>
        <div class="checklist-box">
          <ul class="checklist">
            <li>{t.checklistItem1}</li>
            <li>{t.checklistItem2}</li>
            <li>{t.checklistItem3}</li>
            <li>{t.checklistItem4}</li>
            <li>{t.checklistItem5}</li>
          </ul>
        </div>
      </section>
      <div class="cta-section">
        <h2 class="cta-title">{t.ctaTitle}</h2>
        <a href="/" class="cta-button">{t.ctaButton}</a>
      </div>
    </main>
  </Container>
</Layout>

<style>
  .guide-hero { max-width: 800px; margin: 0 auto 4rem; text-align: center; }
  .section-title { font-size: 2rem; font-weight: 700; color: var(--text-heading); margin-bottom: 1rem; text-align: center; }
  .intro-text { font-size: 1.125rem; color: var(--text-secondary); line-height: 1.8; max-width: 600px; margin: 0 auto; }
  .section-desc { text-align: center; color: var(--text-secondary); margin-bottom: 2rem; }
  .fundamentals-section { margin-bottom: 4rem; }
