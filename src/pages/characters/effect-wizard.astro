---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";

const { locale = 'en' } = Astro.props;

const translations = {
  en: {
    title: "Effect Wizard - Sprunki Sound Effects Character",
    desc: "Meet Effect Wizard, the magical sound effects character in Sprunki. Learn about his sparkling transitions and special sounds that add excitement to your music.",
    characterName: "Effect Wizard",
    role: "Sound Effects Master",
    intro: "The Magic of Sound Effects",
    introDesc: "Effect Wizard is the mystical character who brings sparkle, surprise, and special moments to your compositions. With his bag of sonic tricks, he transforms ordinary tracks into extraordinary musical adventures.",
    soundProfile: "Sound Profile",
    sound1: "Sparkling Transitions",
    sound1Desc: "Magical sound effects that bridge different song sections",
    sound2: "Special One-Shots",
    sound2Desc: "Unique sound effects for accent and emphasis",
    sound3: "Atmospheric Textures",
    sound3Desc: "Ambient soundscapes that add depth and atmosphere",
    personality: "Character Personality",
    personalityDesc: "Mysterious, unpredictable, and full of surprises. Effect Wizard keeps listeners on their toes with unexpected sonic delights that appear when least expected.",
    howToUse: "How to Use Effect Wizard",
    tip1: "Use Sparingly",
    tip1Desc: "A little magic goes a long way - don't overuse effects",
    tip2: "Time Your Drops",
    tip2Desc: "Place effects at transition points or to emphasize beats",
    tip3: "Layer for Impact",
    tip3Desc: "Combine multiple effects for climactic moments",
    relatedCharacters: "Related Characters",
    ctaTitle: "Ready to Add Magic to Your Mix?",
    ctaButton: "Start Creating Now"
  },
  zh: {
    title: "音效巫师 - Sprunki音效角色",
    desc: "认识音效巫师，Sprunki中神奇的音效角色。了解他闪烁的过渡音效和特殊声音，如何为你的音乐增添兴奋感。",
    characterName: "音效巫师",
    role: "音效大师",
    intro: "音效的魔力",
    introDesc: "音效巫师是一个神秘的角色，为你的作品带来闪光、惊喜和特殊时刻。凭借他的声音技巧包，他将普通的曲目转化为非凡的音乐冒险。",
    soundProfile: "声音配置",
    sound1: "闪烁过渡",
    sound1Desc: "连接不同歌曲段落的神奇音效",
    sound2: "特殊单发音",
    sound2Desc: "用于强调和突出的独特音效",
    sound3: "氛围纹理",
    sound3Desc: "增添深度和氛围的环境音景",
    personality: "角色个性",
    personalityDesc: "神秘、不可预测、充满惊喜。音效巫师在最意想不到的时候出现意想不到的 sonic delights，让听众保持警觉。",
    howToUse: "如何使用音效巫师",
    tip1: "谨慎使用",
    tip1Desc: "一点点魔力就能走很远 - 不要过度使用效果",
    tip2: "把握时机",
    tip2Desc: "在过渡点放置效果或用来强调节拍",
    tip3: "叠加增强",
    tip3Desc: "组合多个效果创造高潮时刻",
    relatedCharacters: "相关角色",
    ctaTitle: "准备好为你的混音增添魔力了吗？",
    ctaButton: "立即开始创作"
  },
  es: {
    title: "Mago de Efectos - Personaje de Efectos de Sonido de Sprunki",
    desc: "Conoce al Mago de Efectos, el personaje mágico de efectos de sonido en Sprunki. Aprende sobre sus transiciones brillantes y sonidos especiales.",
    characterName: "Mago de Efectos",
    role: "Maestro de Efectos",
    intro: "La Magia de los Efectos de Sonido",
    introDesc: "El Mago de Efectos es el personaje místico que aporta brillo, sorpresa y momentos especiales a tus composiciones.",
    soundProfile: "Perfil de Sonido",
    sound1: "Transiciones Brillantes",
    sound1Desc: "Efectos mágicos que conectan diferentes secciones",
    sound2: "One-Shots Especiales",
    sound2Desc: "Efectos únicos para acento y énfasis",
    sound3: "Texturas Atmosféricas",
    sound3Desc: "Paisajes sonoros ambientales que añaden profundidad",
    personality: "Personalidad del Personaje",
    personalityDesc: "Misterioso, impredecible y lleno de sorpresas. El Mago de Efectos mantiene a los oyentes alerta.",
    howToUse: "Cómo Usar el Mago de Efectos",
    tip1: "Úsalo con Moderación",
    tip1Desc: "Un poco de magia rinde mucho - no abuses de los efectos",
    tip2: "Cronometra tus Drops",
    tip2Desc: "Coloca efectos en puntos de transición o para enfatizar",
    tip3: "Superpon para Impacto",
    tip3Desc: "Combina múltiples efectos para momentos climáticos",
    relatedCharacters: "Personajes Relacionados",
    ctaTitle: "¿Listo para Agregar Magia a tu Mezcla?",
    ctaButton: "Comenzar a Crear"
  },
  fil: {
    title: "Wizard ng Effects - Karakter ng Sound Effects ng Sprunki",
    desc: "Kilalanin ang Wizard ng Effects, ang mahiwagang karakter ng sound effects sa Sprunki. Alamin ang kanyang mga nagniningning na transitions.",
    characterName: "Wizard ng Effects",
    role: "Master ng Effects",
    intro: "Ang Mahika ng mga Sound Effects",
    introDesc: "Ang Wizard ng Effects ay ang misteryosong karakter na nagdadala ng ningning, sorpresa at mga espesyal na sandali.",
    soundProfile: "Profile ng Tunog",
    sound1: "Nagniningning na Transitions",
    sound1Desc: "Mga mahiwagang sound effects na nagdudugtong sa mga seksyon",
    sound2: "Espesyal na One-Shots",
    sound2Desc: "Natatanging mga sound effects para sa accent at emphasis",
    sound3: "Atmospheric Textures",
    sound3Desc: "Mga ambient soundscape na nagdadagdag ng lalim",
    personality: "Personalidad ng Karakter",
    personalityDesc: "Misteryoso, hindi mahuhulaan, at puno ng sorpresa. Ang Wizard ng Effects ay nagpapanatili sa mga tagapakinig sa kanilang mga daliri.",
    howToUse: "Paano Gamitin ang Wizard ng Effects",
    tip1: "Gamitin nang Bahagya",
    tip1Desc: "Ang kaunting mahika ay makararating ng malayo - huwag magsobra",
    tip2: "I-time ang Iyong Drops",
    tip2Desc: "Ilagay ang mga effects sa transition points o para i-emphasize",
    tip3: "Maglagay para sa Impact",
    tip3Desc: "Pagsamahin ang maraming effects para sa mga climactic moments",
    relatedCharacters: "Kaugnay na mga Karakter",
    ctaTitle: "Handa nang Magdagdag ng Mahika sa Iyong Mix?",
    ctaButton: "Simulang Lumikha"
  }
};

const t = translations[locale] || translations.en;

const relatedCharacters = [
  { name: locale === 'zh' ? "节拍大师" : locale === 'es' ? "Maestro del Ritmo" : locale === 'fil' ? "Master ng Beat" : "Beat Master", type: "beat", icon: "🥁", color: "#EF4444", link: "/characters/beat-master" },
  { name: locale === 'zh' ? "旋律精灵" : locale === 'es' ? "Hada de la Melodía" : locale === 'fil' ? "Diwata ng Melody" : "Melody Sprite", type: "melody", icon: "🎵", color: "#8B5CF6", link: "/characters/melody-sprite" },
  { name: locale === 'zh' ? "歌者" : locale === 'es' ? "Cantante" : locale === 'fil' ? "Mang-aawit" : "Vocalist", type: "vocal", icon: "🎤", color: "#F59E0B", link: "/characters/vocalist" }
];

const characterSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": t.characterName,
  "description": t.desc,
  "url": "https://sprunkigames.online/characters/effect-wizard",
  "knowsAbout": ["Music", "Sound Effects", "Audio Production"],
  "memberOf": { "@type": "Organization", "name": "Sprunki Characters" }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": locale === 'zh' ? '首页' : locale === 'es' ? 'Inicio' : locale === 'fil' ? 'Home' : 'Home', "item": "https://sprunkigames.online" },
    { "@type": "ListItem", "position": 2, "name": locale === 'zh' ? '角色' : locale === 'es' ? 'Personajes' : locale === 'fil' ? 'Mga Karakter' : 'Characters', "item": "https://sprunkigames.online/characters" },
    { "@type": "ListItem", "position": 3, "name": t.characterName, "item": `https://sprunkigames.online/${locale === 'en' ? '' : locale + '/'}characters/effect-wizard` }
  ]
};
---

<Layout title={t.title} description={t.desc}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(characterSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <Container>
    <Sectionhead>
      <Fragment slot="title">{t.characterName}</Fragment>
      <Fragment slot="desc">{t.role}</Fragment>
    </Sectionhead>
    <main class="mt-16">
      <section class="character-hero">
        <div class="character-avatar-large" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(16, 185, 129, 0.05) 100%); border-color: #10B981;">
          <span class="avatar-emoji">✨</span>
        </div>
        <h2 class="section-title">{t.intro}</h2>
        <p class="intro-text">{t.introDesc}</p>
      </section>
      <section class="sounds-section">
        <h2 class="section-title">{t.soundProfile}</h2>
        <div class="sounds-grid">
          <div class="sound-card" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(16, 185, 129, 0.02) 100%); border-color: rgba(16, 185, 129, 0.2);">
            <div class="sound-icon">✨</div>
            <h3 class="sound-title">{t.sound1}</h3>
            <p class="sound-desc">{t.sound1Desc}</p>
          </div>
          <div class="sound-card" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(16, 185, 129, 0.02) 100%); border-color: rgba(16, 185, 129, 0.2);">
            <div class="sound-icon">🎆</div>
            <h3 class="sound-title">{t.sound2}</h3>
            <p class="sound-desc">{t.sound2Desc}</p>
          </div>
          <div class="sound-card" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(16, 185, 129, 0.02) 100%); border-color: rgba(16, 185, 129, 0.2);">
            <div class="sound-icon">🌌</div>
            <h3 class="sound-title">{t.sound3}</h3>
            <p class="sound-desc">{t.sound3Desc}</p>
          </div>
        </div>
      </section>
      <section class="personality-section">
        <h2 class="section-title">{t.personality}</h2>
        <div class="personality-card">
          <div class="personality-avatar" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.2) 0%, rgba(16, 185, 129, 0.05) 100%); border-color: #10B981;">🔮</div>
          <p class="personality-text">{t.personalityDesc}</p>
        </div>
      </section>
      <section class="tips-section">
        <h2 class="section-title">{t.howToUse}</h2>
        <div class="tips-grid">
          <div class="tip-item">
            <div class="tip-number" style="background: linear-gradient(135deg, #10B981 0%, #34D399 100%);">1</div>
            <div class="tip-content">
              <h3 class="tip-title">{t.tip1}</h3>
              <p class="tip-desc">{t.tip1Desc}</p>
            </div>
          </div>
          <div class="tip-item">
            <div class="tip-number" style="background: linear-gradient(135deg, #10B981 0%, #34D399 100%);">2</div>
            <div class="tip-content">
              <h3 class="tip-title">{t.tip2}</h3>
              <p class="tip-desc">{t.tip2Desc}</p>
            </div>
          </div>
          <div class="tip-item">
            <div class="tip-number" style="background: linear-gradient(135deg, #10B981 0%, #34D399 100%);">3</div>
            <div class="tip-content">
              <h3 class="tip-title">{t.tip3}</h3>
              <p class="tip-desc">{t.tip3Desc}</p>
            </div>
          </div>
        </div>
      </section>
      <section class="related-section">
        <h2 class="section-title">{t.relatedCharacters}</h2>
        <div class="related-grid">
          {relatedCharacters.map((char) => (
            <a href={char.link} class="related-card" style={`--char-color: ${char.color}`}>
              <div class="related-icon" style={`background: ${char.color}20; border-color: ${char.color}`}><span>{char.icon}</span></div>
              <h3 class="related-name">{char.name}</h3>
              <span class="related-type">{char.type}</span>
            </a>
          ))}
        </div>
      </section>
      <div class="cta-section" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(59, 130, 246, 0.05) 100%); border-color: rgba(16, 185, 129, 0.2);">
        <h2 class="cta-title">{t.ctaTitle}</h2>
        <a href="/" class="cta-button" style="background: linear-gradient(135deg, #10B981 0%, #3B82F6 100%); box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);">{t.ctaButton}</a>
      </div>
    </main>
  </Container>
</Layout>

<style>
  .character-hero { max-width: 800px; margin: 0 auto 4rem; text-align: center; }
  .character-avatar-large { width: 150px; height: 150px; border-radius: 50%; border: 3px solid; display: flex; align-items: center; justify-content: center; margin: 0 auto 2rem; }
  .avatar-emoji { font-size: 5rem; }
  .section-title { font-size: 2rem; font-weight: 700; color: var(--text-heading); margin-bottom: 1rem; text-align: center; }
  .intro-text { font-size: 1.125rem; color: var(--text-secondary); line-height: 1.8; max-width: 600px; margin: 0 auto; }
  .sounds-section { margin-bottom: 4rem; }
  .sounds-grid { display: grid; grid-template-columns: repeat(1, 1fr); gap: 1.5rem; max-width: 900px; margin: 0 auto; }
  @media (min-width: 768px) { .sounds-grid { grid-template-columns: repeat(3, 1fr); } }
  .sound-card { border: 1px solid; border-radius: 20px; padding: 2rem; text-align: center; transition: all 0.3s ease; }
  .sound-card:hover { transform: translateY(-4px); }
  .sound-icon { font-size: 3rem; margin-bottom: 1rem; }
  .sound-title { font-size: 1.25rem; font-weight: 600; color: var(--text-heading); margin: 0 0 0.75rem 0; }
  .sound-desc { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .personality-section { margin-bottom: 4rem; }
  .personality-card { max-width: 700px; margin: 0 auto; background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 20px; padding: 2.5rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 1.5rem; }
  .personality-avatar { width: 80px; height: 80px; border-radius: 50%; border: 2px solid; display: flex; align-items: center; justify-content: center; font-size: 2.5rem; }
  .personality-text { font-size: 1.125rem; color: var(--text-secondary); line-height: 1.8; margin: 0; }
  .tips-section { margin-bottom: 4rem; }
  .tips-grid { max-width: 700px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; }
  .tip-item { display: flex; gap: 1.5rem; padding: 1.5rem; background: linear-gradient(135deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0.01) 100%); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; transition: all 0.3s ease; }
  .tip-item:hover { border-color: rgba(16, 185, 129, 0.3); }
  .tip-number { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1.25rem; border-radius: 12px; flex-shrink: 0; }
  .tip-content { flex: 1; }
  .tip-title { font-size: 1.125rem; font-weight: 600; color: var(--text-heading); margin: 0 0 0.5rem 0; }
  .tip-desc { font-size: 0.95rem; color: var(--text-secondary); line-height: 1.6; margin: 0; }
  .related-section { margin-bottom: 4rem; }
  .related-grid { display: grid; grid-template-columns: repeat(1, 1fr); gap: 1.5rem; max-width: 900px; margin: 0 auto; }
  @media (min-width: 768px) { .related-grid { grid-template-columns: repeat(3, 1fr); } }
  .related-card { background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.02) 100%); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 16px; padding: 1.5rem; text-align: center; text-decoration: none; transition: all 0.3s ease; display: flex; flex-direction: column; align-items: center; gap: 0.75rem; }
  .related-card:hover { border-color: var(--char-color, #10B981); transform: translateY(-4px); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2); }
  .related-icon { width: 70px; height: 70px; border-radius: 50%; border: 2px solid; display: flex; align-items: center; justify-content: center; font-size: 2rem; }
  .related-name { font-size: 1.125rem; font-weight: 600; color: var(--text-heading); margin: 0; }
  .related-type { font-size: 0.75rem; font-weight: 500; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); }
  .cta-section { text-align: center; padding: 4rem 2rem; border-radius: 24px; border: 1px solid; }
  .cta-title { font-size: 2rem; font-weight: 700; color: var(--text-heading); margin-bottom: 1.5rem; }
  .cta-button { display: inline-flex; align-items: center; gap: 0.75rem; padding: 1rem 2.5rem; color: white; border-radius: 50px; font-weight: 600; text-decoration: none; transition: all 0.3s ease; }
  .cta-button:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(16, 185, 129, 0.5); }
</style>
