---

<div class="nav-shell">
  <Container class="w-full">
    <header class="nav-inner">
    <Astronav>
      <div class="brand-block">
        <a
          href={`/${locale === "en" ? "" : locale}`}
          title="Sprunki Games online"
          class="brand-link">
          <Image
            src="/android-chrome-512x512.png"
            alt="Sprunki Games"
            width={64}
            height={64}
            class="logo-image"
          />
          <div class="brand-text">
            <span class="gradient-text text-xl font-semibold leading-none">Sprunki</span>
            <span class="text-xs uppercase tracking-[0.3em] text-white/60">Playground</span>
          </div>
        </a>
        <div class="lg:hidden">
          <MenuIcon class="w-5 h-5 text-white" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-4 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:items-center lg:gap-4 w-full">
          {
            t.menuItems.map((item, index) => (
              <>
                {item.children ? (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === t.menuItems.length - 1}
                  />
                ) : (
                  <li>
                    {/* 检查是否是外部链接 */}
                    {item.path.startsWith("http") ? (
                      <a
                        href={item.path}  
                        title={item.title}
                        target="_blank"   
                        rel="noopener noreferrer" 
                        class="nav-link external">
                        <Icon name={item.icon} class="w-5 h-5" />
                        <span>{item.title}</span>
                      </a>
                    ) : (
                      <a
                        href={`/${locale === "en" ? "" : locale}${item.path}`}  
                        title={item.title}
                        class="nav-link">
                        <Icon name={item.icon} class="w-5 h-5" />
                        <span>{item.title}</span>
                      </a>
                    )}
                  </li>
                )}
              </>
            ))
          }
          <li class="flex items-center">
            <LanguagePicker />
          </li>
          <li>
            <a href="#Gameplay" class="neon-button nav-cta">
              <Icon name="heroicons:play" class="w-5 h-5" />
              {locale === "zh" ? "立即开玩" : "Start Playing"}
            </a>
          </li>
        </ul>
      </MenuItems>
    </Astronav>
    </header>
  </Container>
</div>

<style>
  .nav-shell {
    position: sticky;
    top: 0;
    z-index: 50;
    padding: 1rem 0;
    background: linear-gradient(180deg, rgba(15,15,18,0.95), rgba(15,15,18,0.65));
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .nav-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .brand-block {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
  }

  .logo-image {
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 1.1rem;
    border-radius: 999px;
    text-transform: none;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    transition: background 0.3s ease, color 0.3s ease;
  }

  .nav-link:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .nav-link.external {
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav-cta {
    padding-inline: 1.8rem;
  }

  @media (min-width: 1024px) {
    .nav-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
    }
  }
</style>
