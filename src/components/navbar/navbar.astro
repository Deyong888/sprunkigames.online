---
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import LanguagePicker from "../LanguagePicker.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";
import { Icon } from 'astro-icon/components';
import Image from "astro/components/Image.astro";

const { locale = "en" } = Astro.props;

const translations = {
  zh: {
    about: "关于",
    privacy: "隐私政策",
    new: "新",
    menuItems: [
    //  {
    //    title: "更多游戏",
    //    path: "#",
    //    children: [
    //      { title: "subway surfers", path: "https://subwaysurfersgame.run" },
    //      { title: "escape road", path: "https://escaperoads.online" },
    //      { title: "sudoku", path: "https://sudoku.viggle.fun" },
    //      { title: "24k Web Games", path: "https://24kwebgames.com" },
    //    ],
    //  },
      {
        title: "Sprunki 最新游戏",
        path: "/blog",
        icon: "heroicons:play-circle"
      },
      {
        title: "角色",
        path: "/characters",
        icon: "heroicons:users"
      },
      {
        title: "更多游戏",
        path: "https://24kwebgames.com",
        icon: "heroicons:gift-solid"
      },
//      {
//        title: "隐私政策",
//        path: "../privacy",
//      },
    ],
  },
  en: {
    about: "About",
    privacy: "Privacy Policy",
    new: "New",
    menuItems: [
 //     {
 //       title: "More Games",
 //       path: "#",
 //       children: [
 //         { title: "subway surfers", path: "https://subwaysurfersgame.run" },
 //         { title: "escape road", path: "https://escaperoads.online" },
 //         { title: "sudoku", path: "https://sudoku.viggle.fun" },
 //         { title: "24k Web Games", path: "https://24kwebgames.com" },
 //       ],
 //     },
      {
        title: "Newest Games",
        path: "/blog",
        icon: "heroicons:play-circle"
      },
      {
        title: "Characters",
        path: "/characters",
        icon: "heroicons:users"
      },
      {
        title: "More Games",
        path: "https://24kwebgames.com",
        icon: "heroicons:gift-solid"
      },
 //     {
 //       title: "Privacy Policy",
 //       path: "../privacy",
//      },
    ],
  },
  es: {
    about: "Sobre Nosotros",
    privacy: "Política de Privacidad",
    new: "Nuevo",
    menuItems: [
      {
        title: "More Games",
        path: "#",
        icon: "heroicons:ellipsis-horizontal",
        children: [
          { title: "subway surfers", path: "https://subwaysurfersgame.run" },
          { title: "escape road", path: "https://escaperoads.online" },
          { title: "sudoku", path: "https://sudoku.viggle.fun" },
          { title: "24k Web Games", path: "https://24kwebgames.com" },
        ],
      },
      {
        title: "Noticias de Sprunki",
        path: "/blog",
        icon: "heroicons:play-circle"
      },
      {
        title: "Personajes",
        path: "/characters",
        icon: "heroicons:users"
      },
   //   {
   //     title: "Política de Privacidad",
   //     path: "../privacy",
  //    },
    ],
  },
  fil: {
    home: "Home",
    games: "Mga Laro",
    blog: "Blog",
    about: "Tungkol Sa Amin",
    contact: "Makipag-ugnayan",
    play: "Maglaro Ngayon",
    language: "Wika"
  }
};

const t = translations[locale] || translations.en;
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a
          href={`/${locale === "en" ? "" : locale}`}
          title="Sprunki Games online"
          class="text-lg flex items-center">
          <Image
            src="/android-chrome-512x512.png"
            alt="Sprunki Games"
            width={80}
            height={80}
            class="mr-2"
          />
          <span
            class="font-bold bg-gradient-to-r from-[#FF61D8] to-[#6B48FF] bg-clip-text text-transparent">
            <a href="/."  title="Sprunki Games online">Sprunki</a>
          </span>
          <span class="text-[#6B48FF]">Game</span>
        </a>
        <div class="block lg:hidden">
          <MenuIcon class="w-4 h-4 text-[#FF61D8]" />
        </div>
      </div>
      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            t.menuItems.map((item, index) => (
              <>
                {item.children ? (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === t.menuItems.length - 1}
                  />
                ) : (
                  <li>
                    {/* 检查是否是外部链接 */}
                    {item.path.startsWith("http") ? (
                      <a
                        href={item.path}  
                        title={item.title}
                        target="_blank"   
                        rel="noopener noreferrer" 
                        class="flex lg:px-3 py-2 items-center text-[#6B48FF] hover:text-[#FF61D8] transition-colors duration-300">
                        <Icon name={item.icon} class="w-5 h-5 mr-2" />
                        <span>{item.title}</span>
                        {item.badge && (
                          <span class="ml-1 px-2 py-0.5 text-[20px] animate-pulse font-semibold uppercase text-white bg-[#FF61D8] rounded-full">
                            {t.new}
                          </span>
                        )}
                      </a>
                    ) : (
                      <a
                        href={`/${locale === "en" ? "" : locale}${item.path}`}  
                        title={item.title}
                        class="flex lg:px-3 py-2 items-center text-[#6B48FF] hover:text-[#FF61D8] transition-colors duration-300">
                        <Icon name={item.icon} class="w-5 h-5 mr-2" />
                        <span>{item.title}</span>
                        {item.badge && (
                          <span class="ml-1 px-2 py-0.5 text-[20px] animate-pulse font-semibold uppercase text-white bg-[#FF61D8] rounded-full">
                            {t.new}
                          </span>
                        )}
                      </a>
                    )}
                  </li>
                )}
              </>
            ))
          }
          <li class="flex items-center">
            <LanguagePicker />
          </li>
        </ul>
      </MenuItems>
      
        
    </Astronav>
  </header>
</Container>

<style>
  header {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid rgba(255, 97, 216, 0.1);
  }

  .astronav-toggle {
    color: #ff61d8;
  }

  @media (max-width: 768px) {
    .astronav-toggle {
      color: #ff61d8;
    }
  }
</style>
