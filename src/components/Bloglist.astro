---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";

const { locale = 'en' } = Astro.props;

// 多语言翻译
const translations = {
  zh: {
    title: "最新游戏",
    desc: "了解更多 Sprunki Games 的动态",
    readMore: "阅读更多"
  },
  en: {
    title: "Latest Game Posts",
    desc: "Stay updated with Sprunki Games",
    readMore: "Read More"
  },
  es: {
    title: "Últimas Game Publicaciones",
    desc: "Mantente actualizado con Sprunki Games",
    readMore: "Leer Más"
  }
};

const t = translations[locale] || translations.en;

// 获取最新的4篇博客文章
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});

const recentPosts = publishedBlogEntries
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);
---

<section class="py-16">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl font-bold text-center mb-8">{t.title}</h2>
    <p class="text-center text-gray-600 mb-12">{t.desc}</p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {recentPosts.map((post) => (
        <div class="bg-white rounded-lg shadow-md overflow-hidden">
          <a href={`/blog/${post.slug}`} class="block">
            <Picture
              src={post.data.image.src}
              alt={post.data.image.alt}
              sizes="(max-width: 800px) 100vw, 800px"
              width={400}
              height={300}
              class="w-full h-48 object-cover"
            />
            <div class="p-4">
              <h3 class="text-xl font-semibold mb-2 hover:text-blue-600">
                {post.data.title}
              </h3>
              <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                {post.data.excerpt || post.data.description}
              </p>
              <span class="text-blue-500 text-sm">{t.readMore} →</span>
            </div>
          </a>
        </div>
      ))}
    </div>
  </div>
</section> 