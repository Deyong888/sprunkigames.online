---
const { locale = 'en' } = Astro.props;

const translations = {
  zh: {
    title: "分享游戏给好友",
    description: "邀请好友一起来玩合成大西瓜！",
    shareText: "我在玩合成大西瓜，超好玩，快来试试！",
    platforms: {
      wechat: "微信",
      weibo: "微博",
      qq: "QQ",
      douyin: "抖音",
      xiaohongshu: "小红书",
      twitter: "Twitter",
      facebook: "Facebook",
      line: "Line",
      telegram: "Telegram",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      linkedin: "LinkedIn",
      reddit: "Reddit",
      pinterest: "Pinterest"
    }
  },
  en: {
    title: "Share with Friends",
    description: "Invite your friends to play Watermelon Game!",
    shareText: "I'm playing Watermelon Game, it's super fun! Try it now!",
    platforms: {
      wechat: "WeChat",
      weibo: "Weibo",
      qq: "QQ",
      douyin: "TikTok",
      xiaohongshu: "RED",
      twitter: "Twitter",
      facebook: "Facebook",
      line: "Line",
      telegram: "Telegram",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      linkedin: "LinkedIn",
      reddit: "Reddit",
      pinterest: "Pinterest"
    }
  },
  ja: {
    title: "友達とシェア",
    description: "スイカゲームを友達に紹介しよう！",
    shareText: "スイカゲームで遊んでいます。とても面白いですよ！",
    platforms: {
      wechat: "WeChat",
      weibo: "Weibo",
      qq: "QQ",
      douyin: "TikTok",
      xiaohongshu: "RED",
      twitter: "Twitter",
      facebook: "Facebook",
      line: "Line",
      telegram: "Telegram",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      linkedin: "LinkedIn",
      reddit: "Reddit",
      pinterest: "Pinterest"
    }
  }
};

const t = translations[locale] || translations.en;

const currentUrl = Astro.url.href;
const shareText = encodeURIComponent(t.shareText);
const shareUrl = encodeURIComponent(currentUrl);
---

<section class="social-share py-16 bg-gradient-to-b from-white via-green-50 to-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-10">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 bg-gradient-to-r from-green-500 to-red-500 bg-clip-text text-transparent">
        {t.title}
      </h2>
      <p class="text-lg text-gray-600">{t.description}</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 max-w-4xl mx-auto">
      <!-- 中国社交平台 -->
      <button class="share-btn group bg-gradient-to-r from-green-500 to-green-600">
        <span class="icon">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M8.5,13.5A1.5,1.5 0 0,1 7,12A1.5,1.5 0 0,1 8.5,10.5A1.5,1.5 0 0,1 10,12A1.5,1.5 0 0,1 8.5,13.5M15.5,13.5A1.5,1.5 0 0,1 14,12A1.5,1.5 0 0,1 15.5,10.5A1.5,1.5 0 0,1 17,12A1.5,1.5 0 0,1 15.5,13.5M12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22"></path>
          </svg>
        </span>
        <span class="text">{t.platforms.wechat}</span>
      </button>

      <a href={`http://service.weibo.com/share/share.php?url=${shareUrl}&title=${shareText}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-red-500 to-red-600">
        <span class="icon">微</span>
        <span class="text">{t.platforms.weibo}</span>
      </a>

      <a href={`http://connect.qq.com/widget/shareqq/index.html?url=${shareUrl}&title=${shareText}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-blue-400 to-blue-500">
        <span class="icon">Q</span>
        <span class="text">{t.platforms.qq}</span>
      </a>

      <!-- 国际社交平台 -->
      <a href={`https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-black to-gray-800">
        <span class="icon">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
          </svg>
        </span>
        <span class="text">{t.platforms.twitter}</span>
      </a>

      <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-blue-600 to-blue-700">
        <span class="icon">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </span>
        <span class="text">{t.platforms.facebook}</span>
      </a>

      <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-green-500 to-green-600">
        <span class="icon">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
        </span>
        <span class="text">{t.platforms.whatsapp}</span>
      </a>

      <a href={`https://t.me/share/url?url=${shareUrl}&text=${shareText}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-blue-400 to-blue-500">
        <span class="icon">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
          </svg>
        </span>
        <span class="text">{t.platforms.telegram}</span>
      </a>

      <a href={`https://www.linkedin.com/shareArticle?mini=true&url=${shareUrl}&title=${shareText}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-blue-600 to-blue-700">
        <span class="icon">in</span>
        <span class="text">{t.platforms.linkedin}</span>
      </a>

      <a href={`https://pinterest.com/pin/create/button/?url=${shareUrl}&description=${shareText}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-red-600 to-red-700">
        <span class="icon">P</span>
        <span class="text">{t.platforms.pinterest}</span>
      </a>

      <a href={`https://www.reddit.com/submit?url=${shareUrl}&title=${shareText}`}
         target="_blank"
         rel="noopener noreferrer"
         class="share-btn group bg-gradient-to-r from-orange-500 to-orange-600">
        <span class="icon">R</span>
        <span class="text">{t.platforms.reddit}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .share-btn {
    @apply flex items-center justify-center gap-2 px-4 py-3 text-white rounded-xl transition-all duration-300 transform hover:-translate-y-1 hover:shadow-lg text-sm;
  }

  .share-btn .icon {
    @apply flex items-center justify-center transition-transform duration-300 w-6 h-6;
  }

  .share-btn:hover .icon {
    @apply scale-110;
  }

  .share-btn .text {
    @apply font-medium hidden sm:block;
  }

  /* 移动端优化 */
  @media (max-width: 640px) {
    .share-btn {
      @apply px-3 py-2;
    }
    
    .share-btn .icon {
      @apply w-5 h-5;
    }
  }

  /* 动画效果 */
  .share-btn {
    background-size: 200% auto;
    animation: gradient 15s ease infinite;
  }

  @keyframes gradient {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }
</style>

<script>
  // 处理微信分享
  document.addEventListener('DOMContentLoaded', () => {
    const wechatBtn = document.querySelector('.share-btn');
    if (wechatBtn) {
      wechatBtn.addEventListener('click', () => {
        // 这里可以添加显示二维码的逻辑
        alert('请使用微信扫描二维码分享');
      });
    }
  });
</script> 