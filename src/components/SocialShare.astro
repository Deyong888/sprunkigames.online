---
const { locale = 'en' } = Astro.props;

const translations = {
  zh: {
    title: "分享音乐创作",
    description: "与好友分享你的 Sprunki 音乐作品！",
    shareText: "我在 Sprunki 创作了一段超棒的音乐，快来听听看！",
    platforms: {
      wechat: "微信",
      weibo: "微博",
      qq: "QQ",
      douyin: "抖音",
      xiaohongshu: "小红书",
      twitter: "Twitter",
      facebook: "Facebook",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      mercadolibre: "Mercado Libre",
      taringa: "Taringa",
      kwai: "Kwai",
      telegram: "Telegram"
    }
  },
  en: {
    title: "Share Your Music",
    description: "Share your Sprunki musical creation with friends!",
    shareText: "Check out the awesome music I created with Sprunki!",
    platforms: {
      wechat: "WeChat",
      weibo: "Weibo",
      qq: "QQ",
      douyin: "TikTok",
      xiaohongshu: "RED",
      twitter: "Twitter",
      facebook: "Facebook",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      mercadolibre: "Mercado Libre",
      taringa: "Taringa",
      kwai: "Kwai",
      telegram: "Telegram"
    }
  },
  es: {
    title: "Comparte tu Música",
    description: "¡Comparte tu creación musical de Sprunki con amigos!",
    shareText: "¡Mira la increíble música que creé con Sprunki!",
    platforms: {
      wechat: "WeChat",
      weibo: "Weibo",
      qq: "QQ",
      douyin: "TikTok",
      xiaohongshu: "RED",
      twitter: "Twitter",
      facebook: "Facebook",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      mercadolibre: "Mercado Libre",
      taringa: "Taringa",
      kwai: "Kwai",
      telegram: "Telegram"
    }
  },
  fil: {
    title: "Ibahagi ang Iyong Musikal na Karya",
    description: "Ibahagi ang iyong musikal na karya sa Sprunki Game sa iyong mga kaibigan!",
    shareText: "Tingnan ang iyong kahanga-hangang musikal na karya na ginawa sa Sprunki Game!",
    platforms: {
      wechat: "WeChat",
      weibo: "Weibo",
      qq: "QQ",
      douyin: "TikTok",
      xiaohongshu: "RED",
      twitter: "Twitter",
      facebook: "Facebook",
      whatsapp: "WhatsApp",
      instagram: "Instagram",
      mercadolibre: "Mercado Libre",
      taringa: "Taringa",
      kwai: "Kwai",
      telegram: "Telegram"
    }   
  }
};

const t = translations[locale] || translations.en;
const currentUrl = Astro.url.href;
const shareText = encodeURIComponent(t.shareText);
const shareUrl = encodeURIComponent(currentUrl);

const shareOptions = [
  {
    key: "whatsapp",
    icon: "💬",
    label: t.platforms.whatsapp,
    href: `https://api.whatsapp.com/send?text=${shareText}%20${shareUrl}`
  },
  {
    key: "twitter",
    icon: "𝕏",
    label: t.platforms.twitter,
    href: `https://twitter.com/intent/tweet?text=${shareText}&url=${shareUrl}`
  },
  {
    key: "instagram",
    icon: "📸",
    label: t.platforms.instagram,
    href: `https://www.instagram.com/?url=${shareUrl}`
  },
  {
    key: "mercadolibre",
    icon: "ML",
    label: t.platforms.mercadolibre,
    href: `https://www.mercadolibre.com/jms/[country-code]/ml.social.share?url=${shareUrl}`
  },
  {
    key: "taringa",
    icon: "T",
    label: t.platforms.taringa,
    href: `https://www.taringa.net/share?url=${shareUrl}&title=${shareText}`
  },
  {
    key: "telegram",
    icon: "✈️",
    label: t.platforms.telegram,
    href: `https://t.me/share/url?url=${shareUrl}&text=${shareText}`
  }
];

const shareRows = [shareOptions.slice(0, 3), shareOptions.slice(3, 6)];
---

<section class="share-section">
  <div class="section-shell share-shell">
    <div class="share-panel glass-panel">
      <div class="share-copy">
        <p class="pill">{locale === 'zh' ? '分享灵感' : 'Share your mix'}</p>
        <h2>{t.title}</h2>
        <p class="muted">{t.description}</p>
      </div>
      <div class="share-grid">
        {shareRows.map((row) => (
          <div class="share-row">
            {row.map((option) => (
              <a href={option.href}
                 target="_blank"
                 rel="noopener noreferrer"
                 class="share-card">
                <span class="icon">{option.icon}</span>
                <span>{option.label}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .share-section {
    position: relative;
    background: #16161e;
    padding: clamp(5rem, 6vw, 6rem) 0;
    margin-top: clamp(4rem, 5vw, 5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .share-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 50%, rgba(108, 93, 211, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .share-shell {
    max-width: 1100px;
  }

  .share-panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    position: relative;
    z-index: 1;
  }

  .share-copy {
    text-align: center;
  }

  .share-copy h2 {
    font-size: clamp(2rem, 3vw, 2.6rem);
    margin: 0.4rem 0 0.8rem;
    color: var(--text-heading);
  }

  .share-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 820px;
    margin: 0 auto;
  }

  .share-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }

  @media (max-width: 640px) {
    .share-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .share-card {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    text-decoration: none;
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(10px);
    transition: var(--transition-base);
    font-weight: 500;
  }

  .share-card .icon {
    font-size: 1.3rem;
  }

  .share-card:hover {
    border-color: rgba(139, 92, 246, 0.6);
    background: rgba(139, 92, 246, 0.15);
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(139, 92, 246, 0.3);
  }
</style>