---
const { locale = 'en' } = Astro.props;

const translations = {
  zh: {
    title: "常见问题",
    description: "关于合成大西瓜游戏的常见问题解答",
    questions: [
      {
        question: "如何开始游戏？",
        answer: "点击或触摸屏幕即可开始游戏。游戏开始后，点击屏幕可以投放水果，将相同的水果合并成更大的水果。"
      },
      {
        question: "游戏目标是什么？",
        answer: "游戏的目标是通过合并相同的水果来创造出最大的水果——西瓜。从最小的樱桃开始，逐步合成更大的水果。"
      },
      {
        question: "什么情况下游戏结束？",
        answer: "当水果堆叠超过顶部红线时，游戏就会结束。要避免游戏结束，需要及时合并水果，保持场地整洁。"
      },
      {
        question: "如何获得高分？",
        answer: "连续合并水果可以获得连击加分。同时合并多个水果可以获得更高的分数。注意合理利用场地空间，避免水果堆积。"
      },
      {
        question: "游戏数据会保存吗？",
        answer: "游戏会自动保存您的最高分记录在浏览器中。您可以随时查看自己的最佳成绩，并挑战自己的记录。"
      },
      {
        question: "可以在手机上玩吗？",
        answer: "是的，游戏完全支持移动设备。您可以在手机或平板电脑上通过触摸屏玩游戏，体验与电脑端相同的游戏乐趣。"
      }
    ]
  },
  en: {
    title: "Frequently Asked Questions",
    description: "Common questions about the Watermelon Game",
    questions: [
      {
        question: "How do I start playing?",
        answer: "Click or tap the screen to start playing. Once the game begins, click to drop fruits and merge identical fruits to create larger ones."
      },
      {
        question: "What is the goal of the game?",
        answer: "The goal is to create the largest fruit possible - the watermelon - by merging identical fruits together. Start with cherries and work your way up."
      },
      {
        question: "When does the game end?",
        answer: "The game ends when fruits stack up beyond the top red line. To avoid this, make sure to merge fruits regularly and keep the playing field clear."
      },
      {
        question: "How do I get a high score?",
        answer: "You can earn combo points by merging fruits consecutively. Merging multiple fruits at once will also earn you higher points. Use the space wisely to avoid fruit pile-ups."
      },
      {
        question: "Are my game scores saved?",
        answer: "Yes, your high scores are automatically saved in your browser. You can always check your best performance and try to beat your own record."
      },
      {
        question: "Can I play on mobile?",
        answer: "Yes, the game is fully compatible with mobile devices. You can play on your phone or tablet using the touchscreen, enjoying the same experience as on desktop."
      }
    ]
  },
  ja: {
    title: "よくある質問",
    description: "スイカゲームについてよくある質問と回答",
    questions: [
      {
        question: "ゲームの始め方は？",
        answer: "画面をクリックまたはタップしてゲームを開始します。ゲーム開始後、画面をタップしてフルーツを落とし、同じフルーツを合体させてより大きなフルーツを作ります。"
      },
      {
        question: "ゲームの目的は？",
        answer: "最終目標は最大のフルーツであるスイカを作ることです。さくらんぼから始めて、徐々に大きなフルーツを作っていきます。"
      }
      // ... 他の日本語の質問と回答
    ]
  }
};

const t = translations[locale] || translations.en;
---

<section class="faq py-20 bg-gradient-to-b from-white via-red-50 to-green-50">
  <div class="container mx-auto px-4 max-w-4xl">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 bg-gradient-to-r from-red-500 to-green-500 bg-clip-text text-transparent">
        {t.title}
      </h2>
      <p class="text-lg text-gray-600">{t.description}</p>
    </div>

    <div class="space-y-4">
      {t.questions.map((item, index) => (
        <div class="faq-item bg-white rounded-xl shadow-sm border border-green-100 overflow-hidden">
          <button
            class="faq-question w-full px-6 py-4 text-left flex justify-between items-center hover:bg-green-50 transition-colors duration-300"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}>
            <span class="text-lg font-medium text-gray-800">{item.question}</span>
            <svg
              class="w-5 h-5 text-green-500 transform transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </button>
          <div
            id={`faq-answer-${index}`}
            class="faq-answer px-6 py-0 h-0 overflow-hidden transition-all duration-300">
            <p class="text-gray-600 pb-4">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item {
    transition: all 0.3s ease;
  }

  .faq-item:hover {
    transform: translateX(4px);
  }

  .faq-question[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .faq-question[aria-expanded="true"] + .faq-answer {
    height: auto;
    padding-top: 1rem;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqQuestions = document.querySelectorAll('.faq-question');
    
    faqQuestions.forEach(question => {
      question.addEventListener('click', () => {
        const isExpanded = question.getAttribute('aria-expanded') === 'true';
        const answer = question.nextElementSibling;
        
        // 关闭其他所有答案
        faqQuestions.forEach(q => {
          if (q !== question) {
            q.setAttribute('aria-expanded', 'false');
            q.nextElementSibling.style.height = '0';
          }
        });

        // 切换当前答案
        question.setAttribute('aria-expanded', !isExpanded);
        if (!isExpanded) {
          const height = answer.scrollHeight;
          answer.style.height = `${height}px`;
        } else {
          answer.style.height = '0';
        }
      });
    });
  });
</script> 