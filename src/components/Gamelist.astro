---
import { Image } from "astro:assets";
import { games } from "../data/games";
import { gameTranslations } from "../data/translations/games";

const { locale = 'en' } = Astro.props;

// 添加更严格的错误处理
const currentTranslations = gameTranslations[locale] || gameTranslations.en;

// 验证翻译数据的完整性
const validateTranslations = (gameId: string) => {
  const translation = currentTranslations[gameId];
  if (!translation) {
    return gameTranslations.en[gameId]; // 如果当前语言没有翻译，使用英文
  }
  return translation;
};
---

<section class="gamelist-section my-4">
  <div class="container mx-auto px-4">
    <div> <h3 class="text-2xl font-bold text-center mb-4">Click The Game Card below to play</h3></div>
    <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 gap-2">
      {games.map((game) => {
        if (!game || !game.image) return null;
        
        const translation = validateTranslations(game.id);
        
        return (
          <div 
            class="game-card group cursor-pointer"
            data-game-url={game.url}
          >
            <div class="relative overflow-hidden rounded-lg">
              <Image 
                src={game.image} 
                alt={translation?.title || 'Game'}
                width={120}
                height={120}
                class="w-full aspect-square object-cover transform group-hover:scale-105 transition-transform duration-300"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                <div class="absolute bottom-0 left-0 right-0 p-2">
                  <p class="text-white text-xs">
                    {translation?.description || 'Play now'}
                  </p>
                </div>
              </div>
            </div>
            <div class="mt-1">
              <h3 class="text-xs font-semibold text-[#6B48FF] group-hover:text-[#FF61D8] transition-colors duration-300 truncate">
                {translation?.title || 'Game'}
              </h3>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* 保持原有样式不变 */
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gameCards = document.querySelectorAll('.game-card');
    const gameFrame = document.getElementById('gameFrame');

    gameCards.forEach(card => {
      card.addEventListener('click', () => {
        const gameUrl = card.dataset.gameUrl;
        if (gameFrame && gameUrl) {
          gameFrame.src = gameUrl;
          
          // 平滑滚动到游戏区域
          const gameWrapper = document.querySelector('.game-wrapper');
          if (gameWrapper) {
            gameWrapper.scrollIntoView({ behavior: 'smooth' });
          }
        }
      });
    });
  });
</script> 