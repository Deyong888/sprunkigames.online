---
import { Image } from "astro:assets";
import { games } from "../data/games";
import { gameTranslations } from "../data/translations/games";

const { locale = 'en' } = Astro.props;

// 添加更严格的错误处理
const currentTranslations = gameTranslations[locale] || gameTranslations.en;

// 验证翻译数据的完整性
const validateTranslations = (gameId: string) => {
  const translation = currentTranslations[gameId];
  if (!translation) {
    return gameTranslations.en[gameId]; // 如果当前语言没有翻译，使用英文
  }
  return translation;
};
---

<section class="gamelist-section">
  <div class="section-shell --full stacked">
    <div class="gamelist-head">
      <div>
        <p class="pill">{locale === 'zh' ? '高热度游戏库' : 'Always-on Arcade'}</p>
        <h3>{locale === 'zh' ? '点击卡片，立即载入主舞台' : 'Tap a card to load it inside the main stage'}</h3>
        <p class="muted">
          {locale === 'zh'
            ? '每张卡片都是一个新的 Sprunki 宇宙，精选多种玩法、音色与挑战。'
            : 'Every card opens a new Sprunki universe packed with unique kits, visuals, and challenges.'}
        </p>
      </div>
      <button 
        id="randomGameBtn"
        class="neon-button random-btn"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
        </svg>
        <span>{locale === 'zh' ? '惊喜随机' : 'Surprise me'}</span>
      </button>
    </div>

    <div class="gamelist-filters">
      <div class="category-tabs">
        <button class="tab-btn active" data-filter="all">{locale === 'zh' ? '全部' : 'ALL'}</button>
        <button class="tab-btn" data-filter="hot">{locale === 'zh' ? '热门' : 'HOT'}</button>
        <button class="tab-btn" data-filter="new">{locale === 'zh' ? '上新' : 'NEW'}</button>
        <button class="tab-btn" data-filter="trending">{locale === 'zh' ? '趋势' : 'TRENDING'}</button>
      </div>
      <label class="search-field">
        <span class="sr-only">Search Games</span>
        <svg viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input 
          type="text" 
          id="gameSearch"
          placeholder={locale === 'zh' ? '搜索 Sprunki 宇宙...' : 'Search Sprunki universes...'}
        />
      </label>
      <div class="filter-note">
        {locale === 'zh' ? '精选 180+ 模组 · 全部支持桌面与移动端' : '180+ modules · Desktop & Mobile ready'}
      </div>
    </div>

    <div class="games-grid-wrapper">
      <div class="games-grid" id="gameGrid" data-initial-count="15">
        {games.filter(game => game && game.image).map((game, index) => {
          const translation = validateTranslations(game.id);
          const badgeType = game.id.endsWith("1") ? "hot" : game.id.endsWith("2") ? "new" : null;
          
          return (
            <div 
              class="game-card-grid"
              data-game-url={game.url}
              data-index={index}
              style={`display: ${index < 15 ? 'flex' : 'none'};`}
            >
              <div class="card-media">
                {badgeType && (
                  <span class:list={["badge", badgeType === "hot" ? "--hot" : "--new"]}>
                    {badgeType === "hot" ? (locale === 'zh' ? '热门' : 'Hot') : (locale === 'zh' ? '上新' : 'New')}
                  </span>
                )}
                <Image 
                  src={game.image} 
                  alt={translation?.title || 'Game'}
                  width={400}
                  height={225}
                  class="game-thumb"
                  loading={index < 8 ? "eager" : "lazy"}
                  decoding={index < 8 ? "sync" : "async"}
                />
                <div class="card-overlay">
                  <div class="overlay-content">
                    <p class="overlay-title">{translation?.title || 'Game'}</p>
                    <p class="overlay-desc">{translation?.description || 'Play now'}</p>
                    <button class="play-indicator">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
              <div class="card-title">
                <p>{translation?.title || 'Game'}</p>
              </div>
            </div>
          );
        })}
      </div>
      {games.filter(game => game && game.image).length > 15 && (
        <div class="load-more-wrapper">
          <button id="loadMoreBtn" class="load-more-btn" data-locale={locale}>
            <span>{locale === 'zh' ? '查看所有游戏' : 'View All Games'}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
        </div>
      )}
    </div>

  </div>
</section>

<style>
  .gamelist-section {
    padding: clamp(4rem, 8vw, 6rem) 0;
    background: linear-gradient(180deg, 
      rgba(15, 15, 25, 0.5) 0%,
      rgba(10, 10, 18, 0.8) 50%,
      rgba(15, 15, 25, 0.5) 100%
    );
    position: relative;
    overflow: hidden;
  }

  .gamelist-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent, 
      rgba(139, 92, 246, 0.3), 
      rgba(0, 224, 255, 0.3), 
      rgba(139, 92, 246, 0.3), 
      transparent
    );
  }

  .gamelist-head {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .gamelist-head h3 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.5rem 0 0;
    color: var(--text-heading);
    font-weight: 700;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff 0%, #e0e0ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .gamelist-head .pill {
    background: linear-gradient(135deg, rgba(108, 93, 211, 0.2), rgba(139, 92, 246, 0.15));
    border: 1px solid rgba(139, 92, 246, 0.25);
    color: #a5b4fc;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.4rem 1rem;
    letter-spacing: 0.1em;
  }

  .gamelist-head .muted {
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    color: rgba(255, 255, 255, 0.6);
    max-width: 600px;
    line-height: 1.6;
  }

  .gamelist-filters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .category-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .tab-btn {
    padding: 0.5rem 1rem;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .tab-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(139, 92, 246, 0.3);
  }

  .tab-btn.active {
    background: linear-gradient(135deg, #7F5AF0 0%, #8B5CF6 100%);
    border-color: transparent;
    color: #fff;
    box-shadow: 0 4px 12px rgba(127, 90, 240, 0.3);
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.04);
    transition: var(--transition-base);
    cursor: text;
  }

  .search-field:focus-within {
    border-color: rgba(0, 224, 255, 0.4);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 0 0 3px rgba(0, 224, 255, 0.1);
  }

  .search-field svg {
    width: 1.5rem;
    height: 1.5rem;
    stroke: rgba(255, 255, 255, 0.5);
    flex-shrink: 0;
  }

  .search-field input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 400;
  }

  .search-field input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .filter-note {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .games-grid-wrapper {
    position: relative;
    margin: 2rem 0;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: auto;
    gap: 1.5rem;
    padding: 0;
  }

  @media (min-width: 768px) {
    .games-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1200px) {
    .games-grid {
      grid-template-columns: repeat(5, 1fr);
      max-width: 100%;
    }
  }

  .game-card-grid {
    cursor: pointer;
    border-radius: 16px;
    background: linear-gradient(145deg, rgba(22, 22, 32, 0.9) 0%, rgba(15, 15, 25, 0.95) 100%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .game-card-grid::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(135deg, 
      rgba(139, 92, 246, 0) 0%, 
      rgba(139, 92, 246, 0.3) 50%, 
      rgba(0, 224, 255, 0.3) 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .game-card-grid:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: rgba(139, 92, 246, 0.3);
    box-shadow: 
      0 20px 40px rgba(139, 92, 246, 0.3),
      0 0 60px rgba(139, 92, 246, 0.1);
    z-index: 2;
  }

  .game-card-grid:hover::before {
    opacity: 1;
  }

  .game-card-grid.active {
    border-color: rgba(139, 92, 246, 0.5);
    box-shadow: 
      0 0 20px rgba(139, 92, 246, 0.4),
      inset 0 0 20px rgba(139, 92, 246, 0.05);
  }

  .game-card-grid.active::before {
    opacity: 1;
  }

  .card-media {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .game-thumb {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }

  .game-card-grid:hover .game-thumb {
    transform: scale(1.05);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(5, 8, 15, 0.95), rgba(5, 8, 15, 0.4) 40%, transparent 70%);
    opacity: 0;
    transition: opacity 0.4s ease;
    padding: 1.25rem;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    color: #fff;
  }

  .game-card-grid:hover .card-overlay,
  .game-card-grid.active .card-overlay {
    opacity: 1;
  }

  .card-title {
    padding: 1rem;
    background: linear-gradient(180deg, rgba(22, 22, 32, 0.95) 0%, rgba(15, 15, 25, 0.98) 100%);
    border-top: 1px solid rgba(139, 92, 246, 0.1);
  }

  .card-title p {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: 0.02em;
  }

  .load-more-wrapper {
    margin-top: 3rem;
    display: flex;
    justify-content: center;
    padding: 2rem 0;
  }

  .load-more-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 2.5rem;
    background: linear-gradient(135deg, #7F5AF0 0%, #8B5CF6 100%);
    border: none;
    border-radius: 50px;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 4px 15px rgba(127, 90, 240, 0.3);
    position: relative;
    overflow: hidden;
  }

  .load-more-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .load-more-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(127, 90, 240, 0.5);
  }

  .load-more-btn:hover::before {
    opacity: 1;
  }

  .load-more-btn span,
  .load-more-btn svg {
    position: relative;
    z-index: 1;
  }

  .load-more-btn svg {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .load-more-btn:hover svg {
    transform: translateY(2px);
  }

  .overlay-content {
    text-align: center;
    width: 100%;
  }

  .overlay-title {
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
    color: #fff;
  }

  .overlay-desc {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 0.8rem;
    line-height: 1.4;
  }

  .play-indicator {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(0, 224, 255, 0.9);
    border: 2px solid rgba(255, 255, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .play-indicator svg {
    width: 24px;
    height: 24px;
    color: #fff;
    margin-left: 2px;
  }

  .play-indicator:hover {
    transform: scale(1.1);
    background: var(--accent-cyan);
    box-shadow: 0 0 20px rgba(0, 224, 255, 0.6);
  }



  .random-btn {
    width: fit-content;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-5px); }
    75% { transform: translateX(5px); }
  }

  .shake {
    animation: shake 0.5s ease-in-out;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (min-width: 900px) {
    .gamelist-head {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const gameGrid = document.getElementById('gameGrid');
    const loadMoreBtn = document.getElementById('loadMoreBtn');
    const initialVisibleCount = Number(gameGrid?.getAttribute('data-initial-count') || '15');
    const gameCards = Array.from(document.querySelectorAll('.game-card-grid'));
    const loadMoreLocale = loadMoreBtn?.getAttribute('data-locale') || 'en';
    const labelMap = {
      view: loadMoreLocale === 'zh' ? '查看所有游戏' : 'View All Games',
      collapse: loadMoreLocale === 'zh' ? '收起游戏' : 'Show Less'
    };
    let allGamesVisible = false;
    let isSearching = false;

    const updateButtonLabel = (expanded: boolean) => {
      if (!loadMoreBtn) return;
      loadMoreBtn.innerHTML = `
        <span>${expanded ? labelMap.collapse : labelMap.view}</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="${expanded ? 'M5 15l7-7 7 7' : 'M19 9l-7 7-7-7'}"/>
        </svg>
      `;
    };

    const applyVisibility = () => {
      gameCards.forEach((card, index) => {
        if (!(card instanceof HTMLElement)) return;
        const shouldShow = allGamesVisible || index < initialVisibleCount;
        card.style.display = shouldShow ? '' : 'none';
        if (!shouldShow) {
          card.classList.remove('active');
        }
      });
    };

    if (!allGamesVisible) {
      applyVisibility();
      updateButtonLabel(false);
    }

    if (loadMoreBtn && gameCards.length > initialVisibleCount) {
      loadMoreBtn.addEventListener('click', () => {
        if (isSearching) {
          const searchInput = document.getElementById('gameSearch') as HTMLInputElement | null;
          if (searchInput) searchInput.value = '';
          isSearching = false;
        }

        allGamesVisible = !allGamesVisible;
        applyVisibility();
        updateButtonLabel(allGamesVisible);

        if (!allGamesVisible && gameGrid) {
          gameGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    }
    const gameFrame = document.getElementById('gameFrame');
    const searchInput = document.getElementById('gameSearch');
    const randomGameBtn = document.getElementById('randomGameBtn');

    let filteredGames = gameCards;

    // 初始化
    function initialize() {
      filteredGames = Array.from(gameCards);
      
      // 如果有搜索输入框，监听清除事件
      if (searchInput) {
        searchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            (e.target as HTMLInputElement).value = '';
            (e.target as HTMLInputElement).dispatchEvent(new Event('input'));
          }
        });
      }
    }

    // 随机游戏功能
    if (randomGameBtn) {
      randomGameBtn.addEventListener('click', () => {
        // 添加抖动动画
        randomGameBtn.classList.add('shake');
        setTimeout(() => {
          randomGameBtn.classList.remove('shake');
        }, 500);

        // 随机选择一个游戏
        const randomIndex = Math.floor(Math.random() * gameCards.length);
        const randomCard = gameCards[randomIndex];

        // 隐藏所有游戏卡片
        gameCards.forEach(card => {
          if (card instanceof HTMLElement) {
            card.style.display = 'none';
          }
        });

        // 显示随机选中的游戏卡片
        if (randomCard instanceof HTMLElement) {
          randomCard.style.display = 'block';
          
          // 滚动到随机游戏卡片
          randomCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
          
          // 添加高亮效果
          randomCard.classList.add('animate-pulse');
          setTimeout(() => {
            randomCard.classList.remove('animate-pulse');
          }, 1000);
        }
      });
    }

    // 搜索功能
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const target = e.target as HTMLInputElement;
        const searchTerm = target.value.toLowerCase().trim();
        filteredGames = [];
        
        if (searchTerm === '') {
          isSearching = false;
          filteredGames = Array.from(gameCards);
          applyVisibility();
          updateButtonLabel(allGamesVisible);
        } else {
          isSearching = true;
          filteredGames = Array.from(gameCards).filter(card => {
            const overlayTitle = card.querySelector('.overlay-title');
            const overlayDesc = card.querySelector('.overlay-desc');
            const titleText = overlayTitle?.textContent?.toLowerCase() || '';
            const descText = overlayDesc?.textContent?.toLowerCase() || '';
            return titleText.includes(searchTerm) || descText.includes(searchTerm);
          });

          gameCards.forEach((card) => {
            const isVisible = filteredGames.includes(card);
            if (card instanceof HTMLElement) {
              card.style.display = isVisible ? '' : 'none';
            }
          });
        }
        
        if (searchTerm !== '' && filteredGames.length > 0) {
          const firstVisible = filteredGames[0];
          if (firstVisible instanceof HTMLElement) {
            setTimeout(() => {
              firstVisible.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 100);
          }
        }
      });
    }


    // 游戏卡片点击事件
    gameCards.forEach(card => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const gameUrl = card.getAttribute('data-game-url');
        if (gameFrame && gameUrl) {
          // 移除所有active类
          gameCards.forEach(c => c.classList.remove('active'));
          // 添加active类到当前卡片
          card.classList.add('active');
          
          // 更新iframe的src
          const iframe = gameFrame as HTMLIFrameElement;
          
          // 显示加载状态
          const loading = document.querySelector('.game-loading') as HTMLElement;
          if (loading) {
            loading.style.opacity = '1';
            loading.style.visibility = 'visible';
            loading.style.pointerEvents = 'auto';
          }
          
          // 更新游戏URL，添加暗色主题参数
          const separator = gameUrl.includes('?') ? '&' : '?';
          iframe.src = `${gameUrl}${separator}theme=dark`;
          
          // 监听iframe加载完成
          iframe.addEventListener('load', function onLoad() {
            if (loading) {
              setTimeout(() => {
                loading.style.opacity = '0';
                loading.style.visibility = 'hidden';
                loading.style.pointerEvents = 'none';
              }, 500);
            }
            iframe.removeEventListener('load', onLoad);
          }, { once: true });
          
          // 平滑滚动到游戏区域
          const gameSection = document.getElementById('Gameplay');
          if (gameSection) {
            gameSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });


    // 初始化
    initialize();

    // 分类筛选功能
    const categoryTabs = document.querySelectorAll('.tab-btn');
    let currentFilter = 'all';

    categoryTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        // 更新按钮状态
        categoryTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const filter = tab.getAttribute('data-filter') || 'all';
        currentFilter = filter;

        // 重置搜索状态
        if (searchInput) {
          (searchInput as HTMLInputElement).value = '';
        }
        isSearching = false;

        // 根据筛选条件显示游戏
        gameCards.forEach((card, index) => {
          if (!(card instanceof HTMLElement)) return;

          let shouldShow = false;
          const badge = card.querySelector('.badge');
          const hasHotBadge = badge?.classList.contains('--hot');
          const hasNewBadge = badge?.classList.contains('--new');

          switch (filter) {
            case 'all':
              shouldShow = index < initialVisibleCount;
              break;
            case 'hot':
              shouldShow = hasHotBadge;
              break;
            case 'new':
              shouldShow = hasNewBadge;
              break;
            case 'trending':
              // 热门和新游戏都显示为趋势
              shouldShow = hasHotBadge || hasNewBadge;
              break;
          }

          card.style.display = shouldShow ? '' : 'none';
        });

        // 更新"查看更多"按钮状态
        if (loadMoreBtn) {
          const visibleCount = gameCards.filter(card => 
            (card as HTMLElement).style.display !== 'none'
          ).length;
          
          if (filter === 'all' && gameCards.length > initialVisibleCount) {
            loadMoreBtn.style.display = 'flex';
            allGamesVisible = false;
            updateButtonLabel(false);
          } else {
            loadMoreBtn.style.display = visibleCount > initialVisibleCount ? 'flex' : 'none';
          }
        }

        // 滚动到游戏网格
        if (gameGrid) {
          gameGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  });
</script> 