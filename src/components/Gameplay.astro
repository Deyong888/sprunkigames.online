---
import { Icon } from "astro-icon/components";
const { locale, currentGame = "https://play.gamepix.com/sprunki-stunt-driving-simulator/embed?sid=1" } = Astro.props;

const translations = {
  zh: {
    title: "Create Your Music with Sprunki",
    description: "通过拖拽角色、叠加节奏与旋律，几秒钟内完成一首属于你的电子乐。零基础也能玩出大师级的沉浸体验。",
    loading: "游戏加载中...",
    ctaPrimary: "立即开玩",
    ctaSecondary: "查看玩法指南",
    highlights: [
      { label: "20+ 模式", caption: "不断上新的 Universe" },
      { label: "百万次创作", caption: "社区热门作品灵感不停" },
      { label: "实时分享", caption: "一键导出到社交平台" }
    ]
  },
  en: {
    title: "Create Your Music with Sprunki",
    description: "Layer beats, melodies, glitches and FX to craft your signature sound in seconds. No music theory needed — just drop characters and let the groove happen.",
    loading: "Loading game...",
    ctaPrimary: "Play Now",
    ctaSecondary: "See How to Play",
    highlights: [
      { label: "20+ universes", caption: "Fresh sound kits every month" },
      { label: "1M+ mixes", caption: "Community-made inspiration" },
      { label: "Instant sharing", caption: "Export to socials in one tap" }
    ]
  },
  es: {
    title: "Crea tu música con Sprunki",
    description: "Combina ritmos y melodías para producir tu mezcla en segundos. No necesitas teoría: arrastra personajes, desbloquea animaciones y deja que fluya la creatividad.",
    loading: "Cargando juego...",
    ctaPrimary: "Jugar ahora",
    ctaSecondary: "Guía de juego",
    highlights: [
      { label: "20+ universos", caption: "Nuevos kits mensuales" },
      { label: "1M+ mezclas", caption: "Inspiración de la comunidad" },
      { label: "Compartir al instante", caption: "Exporta en un clic" }
    ]
  },
  fil: {
    title: "Gumawa ng sarili mong tunog sa Sprunki",
    description: "Pagpatung-patungin ang beats, melody at FX para bumuo ng kakaibang mix sa ilang segundo. Walang kinakailangang music theory—i-drag mo lang ang mga karakter.",
    loading: "Naglo-load ang laro...",
    ctaPrimary: "Maglaro ngayon",
    ctaSecondary: "Alamin kung paano",
    highlights: [
      { label: "20+ na mundo", caption: "Panibagong kits kada buwan" },
      { label: "1M+ mix", caption: "Inspirasyon mula sa komunidad" },
      { label: "Instant share", caption: "I-export sa socials agad" }
    ]
  }
};

const t = translations[locale] || translations.en;
const heroMetaMap = {
  zh: {
    eyebrow: "实时混音",
    focus: "Sprunki",
    accent: "音乐主控台",
    subline: "拖拽角色、叠加音轨，实时完成全场最炸的混音表演。",
    primaryCta: "浏览热门游戏"
  },
  en: {
    eyebrow: "Live mixing",
    focus: "Sprunki",
    accent: "Command Studio",
    subline: "Trigger kits, layer beats, and run a full show without leaving the page.",
    primaryCta: "Browse featured games"
  },
  es: {
    eyebrow: "Live mixing",
    focus: "Sprunki",
    accent: "Command Studio",
    subline: "Lanza kits, mezcla ritmos y dirige una sesión completa en segundos.",
    primaryCta: "Explorar juegos"
  },
  fil: {
    eyebrow: "Live mixing",
    focus: "Sprunki",
    accent: "Command Studio",
    subline: "I-trigger ang mga kit at bumuo ng buong sesyon nang hindi umaalis sa pahina.",
    primaryCta: "Tingnan ang mga laro"
  }
};

const heroMeta = heroMetaMap[locale] || heroMetaMap.en;
---

<section class="hero-section" id="Gameplay">
  <div class="hero-fullscreen">
    <div class="hero-minimal-header">
      <div class="hero-title-group">
        <span class="pill hero-eyebrow">
          <Icon name="heroicons:musical-note" class="w-4 h-4" />
          {heroMeta.eyebrow}
        </span>
        <h1 class="hero-heading">
          <span class="hero-heading-focus">{heroMeta.focus}</span>
          <span class="hero-heading-divider">/</span>
          <span class="hero-heading-light">{heroMeta.accent}</span>
        </h1>
        <p class="hero-subline">
          {heroMeta.subline}
        </p>
      </div>
      <div class="hero-quick-actions">
        <a href="https://minigameshub.org/" target="_blank" rel="noopener" class="hero-button --primary">
          <Icon name="heroicons:play" class="w-4 h-4" />
          {heroMeta.primaryCta}
        </a>
        <a href="#how-to-play" class="ghost-button-small">
          <Icon name="heroicons:information-circle" class="w-4 h-4" />
          {t.ctaSecondary}
        </a>
      </div>
    </div>

    <div class="hero-visual-fullscreen" id="gameplay-frame">
      <div class="game-wrapper-fullscreen">
        <div class="game-loading">
          <div class="loading-spinner"></div>
          <p class="loading-text">{t.loading}</p>
        </div>
        <iframe 
          id="gameFrame"
          src={currentGame}
          title={t.title}
          class="game-frame-fullscreen"
          frameborder="0"
          loading="eager"
          allow="autoplay; fullscreen; microphone; camera; midi; encrypted-media"
          allowfullscreen
          sandbox="allow-same-origin allow-scripts allow-popups allow-forms allow-downloads allow-modals"
        ></iframe>
        <div class="hud-minimal">
          <div>
            <p class="hud-label">{locale === "zh" ? "当前模式" : "Current Mode"}</p>
            <p class="hud-value">Sprunki Universe</p>
          </div>
          <div>
            <p class="hud-label">{locale === "zh" ? "输入设备" : "Input"}</p>
            <p class="hud-value">Mouse · Keyboard</p>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-stats-bar">
      {t.highlights.map((highlight) => (
        <div class="stat-item">
          <span class="stat-label">{highlight.label}</span>
          <p class="stat-caption">{highlight.caption}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 0;
    margin: 0;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(180deg, 
      rgba(15, 15, 25, 0) 0%,
      rgba(108, 93, 211, 0.03) 50%,
      rgba(15, 15, 25, 0) 100%
    );
  }

  .hero-fullscreen {
    min-height: clamp(680px, 88vh, 900px);
    display: flex;
    flex-direction: column;
    position: relative;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 clamp(1rem, 3vw, 2rem);
  }

  .hero-minimal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: transparent;
    z-index: 10;
    flex-shrink: 0;
  }

  .hero-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hero-title-group h1 {
    font-size: clamp(2rem, 4.5vw, 3.6rem);
    line-height: 1.1;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .hero-heading-focus {
    font-weight: 800;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff 0%, #e0e0ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-heading-divider {
    color: var(--accent-cyan);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 500;
    opacity: 0.8;
  }

  .hero-heading-light {
    font-size: clamp(1.6rem, 3.5vw, 2.6rem);
    color: rgba(255, 255, 255, 0.65);
    font-weight: 400;
  }

  .hero-subline {
    margin: 0.25rem 0 0;
    color: var(--text-secondary);
    max-width: 580px;
    font-size: clamp(0.9rem, 1.5vw, 1.1rem);
    line-height: 1.5;
  }

  .hero-title-group .pill {
    font-size: 0.7rem;
    padding: 0.35rem 0.9rem;
    background: linear-gradient(135deg, rgba(108, 93, 211, 0.2), rgba(139, 92, 246, 0.15));
    border: 1px solid rgba(139, 92, 246, 0.25);
    color: #a5b4fc;
  }

  .hero-eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .hero-quick-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .hero-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-weight: 600;
    border-radius: 999px;
    padding: 0.85rem 1.75rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    font-size: 0.95rem;
  }

  .hero-button.--primary {
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    color: #fff;
    box-shadow: 
      0 8px 30px rgba(108, 93, 211, 0.35),
      0 2px 8px rgba(108, 93, 211, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hero-button.--primary:hover {
    transform: translateY(-2px);
    box-shadow: 
      0 12px 40px rgba(108, 93, 211, 0.45),
      0 4px 12px rgba(108, 93, 211, 0.25);
  }

  .ghost-button-small {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 999px;
    padding: 0.85rem 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    white-space: nowrap;
    background: rgba(255, 255, 255, 0.03);
  }

  .ghost-button-small:hover {
    border-color: rgba(0, 224, 255, 0.5);
    color: var(--accent-cyan);
    background: rgba(0, 224, 255, 0.08);
    transform: translateY(-1px);
  }

  .hero-visual-fullscreen {
    flex: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 0;
    min-height: 0;
  }

  .game-wrapper-fullscreen {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 480px;
    max-height: 720px;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 
      0 0 0 1px rgba(108, 93, 211, 0.1),
      0 25px 80px rgba(5, 6, 20, 0.7),
      0 0 100px rgba(108, 93, 211, 0.15);
    background: linear-gradient(135deg, rgba(10, 10, 18, 0.98) 0%, rgba(18, 18, 28, 0.95) 100%);
    display: flex;
    flex-direction: column;
  }

  .game-wrapper-fullscreen::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 24px;
    padding: 1.5px;
    background: linear-gradient(135deg, 
      rgba(0, 224, 255, 0.3) 0%, 
      rgba(108, 93, 211, 0.3) 50%, 
      rgba(139, 92, 246, 0.3) 100%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
    z-index: 1;
  }

  .game-frame-fullscreen {
    width: 100%;
    height: 100%;
    flex: 1;
    border: none;
    display: block;
    min-height: 0;
    background: #0a0a0f;
    position: relative;
    z-index: 0;
  }

  .game-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: 
      linear-gradient(135deg, rgba(5, 6, 15, 0.98) 0%, rgba(15, 15, 18, 0.95) 100%),
      radial-gradient(circle at 50% 50%, rgba(0, 224, 255, 0.05) 0%, transparent 70%);
    backdrop-filter: blur(10px);
    z-index: 2;
    gap: 0.8rem;
  }

  .loading-spinner {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 4px solid rgba(255, 255, 255, 0.08);
    border-top-color: var(--accent-cyan);
    animation: spin 1s linear infinite;
  }

  .loading-text {
    color: var(--accent-cyan);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  .hud-minimal {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    background: linear-gradient(180deg, rgba(5, 6, 15, 0.95) 0%, rgba(10, 10, 18, 0.98) 100%);
    backdrop-filter: blur(8px);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .hud-minimal::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 224, 255, 0.3), transparent);
  }

  .hud-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.15rem;
  }

  .hud-value {
    font-weight: 600;
    font-size: 0.85rem;
  }

  .hero-stats-bar {
    display: flex;
    justify-content: center;
    gap: clamp(2rem, 6vw, 4rem);
    padding: 1.25rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .stat-item {
    text-align: center;
    min-width: 120px;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.04);
    transition: all 0.3s ease;
  }

  .stat-item:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(139, 92, 246, 0.15);
    transform: translateY(-2px);
  }

  .stat-label {
    display: block;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 800;
    background: linear-gradient(135deg, var(--accent-cyan), #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.3rem;
  }

  .stat-caption {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
    font-weight: 400;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  @media (max-width: 768px) {
    .hero-fullscreen {
      min-height: auto;
      padding: 0 0.75rem;
    }

    .hero-minimal-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
      padding: 1rem 0;
    }

    .hero-visual-fullscreen {
      padding: 0.75rem 0;
    }

    .game-wrapper-fullscreen {
      min-height: 360px;
      border-radius: 16px;
    }

    .game-wrapper-fullscreen::before {
      border-radius: 16px;
    }

    .hud-minimal {
      flex-direction: row;
      gap: 0.5rem;
      padding: 0.6rem 1rem;
    }

    .hero-stats-bar {
      gap: 0.75rem;
      padding: 1rem 0;
    }

    .stat-item {
      min-width: auto;
      flex: 1;
      padding: 0.4rem 0.6rem;
    }

    .stat-label {
      font-size: 0.95rem;
    }

    .stat-caption {
      font-size: 0.7rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const iframe = document.getElementById('gameFrame') as HTMLIFrameElement;
    const loading = document.querySelector('.game-loading') as HTMLElement;
    const gameWrapper = document.querySelector('.game-wrapper-fullscreen') as HTMLElement;

    if (!iframe || !loading) return;

    // 确保iframe正确显示
    iframe.style.width = '100%';
    iframe.style.height = '100%';
    iframe.style.border = 'none';
    iframe.style.display = 'block';
    iframe.style.background = '#0a0a0f';
    
    // 尝试通过URL参数传递暗色主题偏好（如果游戏支持）
    try {
      const currentSrc = iframe.src;
      if (currentSrc && !currentSrc.includes('theme=')) {
        const separator = currentSrc.includes('?') ? '&' : '?';
        iframe.src = `${currentSrc}${separator}theme=dark`;
      }
    } catch (e) {
      // 如果无法修改src，忽略错误
      console.log('Cannot modify iframe src:', e);
    }

    // 监听iframe加载
    iframe.addEventListener('load', () => {
      setTimeout(() => {
        if (loading) {
          loading.style.opacity = '0';
          loading.style.visibility = 'hidden';
          loading.style.pointerEvents = 'none';
        }
      }, 500);
    });

    // 如果iframe已经加载完成
    if (iframe.contentDocument?.readyState === 'complete') {
      loading.style.opacity = '0';
      loading.style.visibility = 'hidden';
      loading.style.pointerEvents = 'none';
    }

    // 调整游戏容器高度以适应内容
    function adjustGameHeight() {
      if (gameWrapper) {
        const viewportHeight = window.innerHeight;
        const headerHeight = document.querySelector('.hero-minimal-header')?.clientHeight || 80;
        const statsHeight = document.querySelector('.hero-stats-bar')?.clientHeight || 80;
        const availableHeight = viewportHeight - headerHeight - statsHeight - 40;
        
        gameWrapper.style.height = `${Math.max(540, Math.min(availableHeight, 780))}px`;
      }
    }

    adjustGameHeight();
    window.addEventListener('resize', adjustGameHeight);
  });
</script>