---
// 导入图片
import dropImg from '../assets/howtoplay/drop.png';
import mergeImg from '../assets/howtoplay/merge.png';
import stackImg from '../assets/howtoplay/stack.png';
import warningImg from '../assets/howtoplay/warning.png';
import tipImg from '../assets/howtoplay/tip.png';
import { Image } from 'astro:assets';

const { locale = 'en' } = Astro.props;

const translations = {
  en: {
    title: "How to Play Watermelon Game",
    description: "Master the art of fruit merging with these simple steps",
    steps: [
      {
        title: "Drop Fruits",
        description: "Click or tap to drop fruits from the top of the screen. Time your drops carefully!",
        image: dropImg
      },
      {
        title: "Match & Merge",
        description: "When two identical fruits touch, they merge into a larger fruit. Start with cherries and work your way up to watermelons!",
        image: mergeImg
      },
      {
        title: "Stack Strategically",
        description: "Plan your moves carefully. Stack similar fruits close to each other for easier merging.",
        image: stackImg
      },
      {
        title: "Avoid Overflow",
        description: "Don't let the fruits stack up too high! If they reach the top line, the game ends.",
        image: warningImg
      }
    ],
    tips: {
      title: "Pro Tips",
      items: [
        "Use the walls to guide falling fruits",
        "Keep an eye on the next fruit",
        "Create space by merging smaller fruits first",
        "Try to keep similar fruits close together"
      ]
    }
  },
  zh: {
    title: "如何玩合成大西瓜",
    description: "通过以下简单步骤掌握水果合成的技巧",
    steps: [
      {
        title: "投放水果",
        description: "点击或触摸屏幕来从顶部投放水果。注意把握投放时机！",
        image: dropImg
      },
      {
        title: "匹配与合成",
        description: "当两个相同的水果接触时，它们会合成更大的水果。从樱桃开始，最终合成西瓜！",
        image: mergeImg
      },
      {
        title: "策略性堆叠",
        description: "仔细规划你的每一步。将相似的水果堆放在一起，便于合成。",
        image: stackImg
      },
      {
        title: "避免溢出",
        description: "不要让水果堆得太高！如果触及顶线，游戏就会结束。",
        image: warningImg
      }
    ],
    tips: {
      title: "高级技巧",
      items: [
        "利用墙壁引导落下的水果",
        "关注下一个水果是什么",
        "优先合成小水果来创造空间",
        "尽量保持相似水果靠近"
      ]
    }
  },
  ja: {
    title: "スイカゲームの遊び方",
    description: "簡単なステップで果物の合成を極めよう",
    steps: [
      {
        title: "フルーツを落とす",
        description: "画面をタップまたはクリックして、上からフルーツを落とします。タイミングを見極めましょう！",
        image: dropImg
      },
      {
        title: "マッチ＆マージ",
        description: "同じフルーツが触れ合うと、より大きなフルーツに合成されます。さくらんぼから始めて、スイカを目指しましょう！",
        image: mergeImg
      },
      {
        title: "戦略的な積み重ね",
        description: "慎重に動きを計画しましょう。似たフルーツを近くに積み重ねると合成しやすくなります。",
        image: stackImg
      },
      {
        title: "オーバーフロー注意",
        description: "フルーツを高く積みすぎないように！上限ラインに達するとゲームオーバーです。",
        image: warningImg
      }
    ],
    tips: {
      title: "プロのコツ",
      items: [
        "壁を使ってフルーツの落下を誘導する",
        "次のフルーツを確認する",
        "小さいフルーツから先に合成してスペースを作る",
        "似たフルーツを近くに配置する"
      ]
    }
  }
};

const t = translations[locale] || translations.en;
---

<section class="how-to-play py-20 bg-gradient-to-b from-green-50 via-white to-red-50">
  <div class="container mx-auto px-4 max-w-6xl">
    <!-- 标题部分 -->
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-bold mb-6 bg-gradient-to-r from-green-500 to-red-500 bg-clip-text text-transparent">
        {t.title}
      </h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed">
        {t.description}
      </p>
    </div>

    <!-- 步骤卡片 -->
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-20">
      {t.steps.map((step, index) => (
        <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1 border border-green-100">
          <div class="relative mb-6">
            <div class="absolute -top-4 -left-4 w-8 h-8 bg-green-500 text-white rounded-full flex items-center justify-center font-bold">
              {index + 1}
            </div>
            <div class="bg-green-50 rounded-xl p-4 flex items-center justify-center">
              <Image 
                src={step.image} 
                alt={step.title}
                class="w-16 h-16 object-contain"
                width="96"
                height="96"
              />
            </div>
          </div>
          <h3 class="text-xl font-bold mb-3 text-green-800">{step.title}</h3>
          <p class="text-gray-600 leading-relaxed">{step.description}</p>
        </div>
      ))}
    </div>

    <!-- 技巧部分 -->
    <div class="bg-gradient-to-r from-green-500 to-red-500 p-1 rounded-2xl">
      <div class="bg-white p-8 rounded-2xl">
        <h3 class="text-3xl font-bold mb-8 text-center bg-gradient-to-r from-green-500 to-red-500 bg-clip-text text-transparent">
          {t.tips.title}
        </h3>
        <div class="grid md:grid-cols-2 gap-6">
          {t.tips.items.map((tip, index) => (
            <div class="flex items-start gap-4 group">
              <div class="flex-shrink-0 w-10 h-10 bg-pink-100 rounded-full flex items-center justify-center group-hover:bg-pink-200 transition-colors duration-300">
                <Image 
                  src={tipImg}
                  alt="tip"
                  class="w-6 h-6"
                  width="24"
                  height="24"
                />
              </div>
              <div class="flex-grow">
                <p class="text-gray-700 leading-relaxed">
                  <span class="font-semibold text-pink-600">提示 {index + 1}:</span> {tip}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-to-play {
    scroll-margin-top: 100px;
  }
  
  @media (max-width: 768px) {
    .how-to-play {
      scroll-margin-top: 60px;
      padding: 3rem 0;
    }
    
    .how-to-play h2 {
      font-size: 2rem;
    }
    
    .how-to-play .grid {
      gap: 1.5rem;
    }
  }

  /* 添加卡片悬停动画 */
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-5px);
    }
    100% {
      transform: translateY(0px);
    }
  }

  .how-to-play .grid > div:hover {
    animation: float 2s ease-in-out infinite;
  }

  /* 渐变背景动画 */
  .bg-gradient-to-r {
    background: linear-gradient(to right, #22c55e, #ef4444);
  }

  @keyframes gradient {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
</style> 