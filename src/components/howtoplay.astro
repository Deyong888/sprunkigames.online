      title: "Sprunki Game Pro Tips",
      items: [
        "I-drag at i-drop ang mga sound icon sa mga karakter para magsimula silang tumugtog.",
        "Gumawa ng iyong natatanging komposisyon sa pamamagitan ng pagkombina ng iba't ibang tunog at rhythm.",
        "I-save ang iyong mga creation at ibahagi ang mga ito sa Sprunki community.",
        "I-explore ang mga gawa ng ibang players sa community o tingnan ang aming regular na ina-update na creation tips at tutorials."
      ]
    } 
  },
};

const t = translations[locale] || translations.en;
---

<section class="how-to-play" id="how-to-play">
  <div class="section-shell --full">
    <div class="text-center mb-10">
      <a href="../blog/how-to-play-sprunki-game">
        <h2>{t.title}</h2>
      </a>
      <p class="muted">{t.description}</p>
    </div>

    <div class="steps-grid">
      {t.steps.map((step, index) => (
        <div class="step-card">
          <div class="step-number-bg">{index + 1}</div>
          <div class="step-visual">
            <Image 
              src={step.image} 
              alt={step.title}
              width="120"
              height="120"
            />
          </div>
          <div class="step-copy">
            <h3>{step.title}</h3>
            <p class="muted">{step.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="tips-board">
      <div class="tips-header">
        <h3>{t.tips.title}</h3>
        <p class="muted">{locale === 'zh' ? '收藏这些灵感，创作时随时调出。' : 'Pin these cues to keep the vibe flowing.'}</p>
      </div>
      <div class="tips-grid">
        {t.tips.items.map((tip, index) => (
          <div class="tip-card">
            <div class="tip-number">
              <Image 
                src={tipImg}
                alt="tip"
                width="24"
                height="24"
              />
              <span>{index + 1}</span>
            </div>
            <p>{tip}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .how-to-play {
    padding-top: clamp(4rem, 6vw, 6rem);
    padding-bottom: clamp(4rem, 6vw, 6rem);
    background: var(--bg-base);
    margin-top: clamp(4rem, 5vw, 5rem);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .steps-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1.5rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    transition: var(--transition-base);
    overflow: hidden;
  }

  .step-card:hover {
    transform: translateY(-4px);
    border-color: rgba(108, 93, 211, 0.4);
    box-shadow: 0 15px 40px rgba(108, 93, 211, 0.2);
  }

  .step-number-bg {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-size: 6rem;
    font-weight: 900;
    color: rgba(108, 93, 211, 0.2);
    line-height: 1;
    z-index: 0;
    pointer-events: none;
  }

  .step-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 1.5rem;
    z-index: 1;
  }

  .step-visual img {
    max-width: 120px;
    filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.35));
  }

  .step-copy {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .step-copy h3 {
    font-size: 1.3rem;
    margin: 0 0 0.75rem 0;
    color: var(--text-heading);
  }

  .step-copy .muted {
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .tips-board {
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0, 224, 255, 0.15);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: linear-gradient(135deg, rgba(0, 224, 255, 0.08), rgba(108, 93, 211, 0.08));
  }

  .tips-header h3 {
    font-size: 1.8rem;
    color: var(--text-heading);
  }

  .tips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .tip-card {
    padding: 1rem;
    border-radius: 18px;
    background: rgba(15, 15, 18, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tip-number {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
  }

  .tip-number span {
    font-weight: 700;
    color: var(--accent-cyan);
  }

  @media (max-width: 768px) {
    .step-card {
      padding: 1.5rem 1rem;
    }

    .step-number-bg {
      font-size: 4rem;
      top: 0.5rem;
      right: 0.5rem;
    }
  }
</style>