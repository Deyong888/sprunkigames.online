---
const locale = Astro.currentLocale || 'en';
const translations = {
  en: {
    brand: 'Create, mix, share — at Sprunki, your inspiration is always on. Keep your headphones charged; late night is the best.',
    columns: {
      play: 'Play',
      support: 'Support',
      network: 'Network',
      characters: 'Characters',
      blog: 'Newest universes',
      pricing: 'VIP modes',
      privacy: 'Privacy',
      terms: 'Terms of Service',
      contact: 'Contact',
      about: 'About Sprunki'
    }
  },
  zh: {
    brand: '创造、混音、分享——在 Sprunki，你的灵感永远在线。保持耳机电量，夜深时最佳。',
    columns: {
      play: '游玩',
      support: '支持',
      network: '网络',
      characters: '角色',
      blog: '最新宇宙',
      pricing: 'VIP 模式',
      privacy: '隐私政策',
      terms: '服务条款',
      contact: '联系我们',
      about: '关于 Sprunki'
    }
  },
  es: {
    brand: 'Crear, mezclar y compartir: en Sprunki tu inspiración siempre está encendida. Mantén tus auriculares cargados; la noche es el mejor momento.',
    columns: {
      play: 'Jugar',
      support: 'Soporte',
      network: 'Red',
      characters: 'Personajes',
      blog: 'Universos más nuevos',
      pricing: 'Modos VIP',
      privacy: 'Política de Privacidad',
      terms: 'Términos de Servicio',
      contact: 'Contacto',
      about: 'Acerca de Sprunki'
    }
  },
  fil: {
    brand: 'Lumikha, mag-mix, magbahagi — sa Sprunki, laging bukas ang inspirasyon mo. Panatilihing may karga ang headphones; pinakamaganda ang gabi.',
    columns: {
      play: 'Maglaro',
      support: 'Suporta',
      network: 'Network',
      characters: 'Mga Tauhan',
      blog: 'Pinakabagong uniberso',
      pricing: 'VIP modes',
      privacy: 'Privacy',
      contact: 'Contact',
      about: 'Tungkol sa Sprunki'
    }
  }
};
const t = translations[locale] || translations.en;
const prefix = locale === 'en' ? '' : `/${locale}`;
---

<footer class="site-footer">
  <div class="section-shell --full footer-grid">
    <div class="footer-brand">
      <div class="logo">
        <img src="/android-chrome-512x512.png" alt="Sprunki Games" width="64" height="64" />
        <div>
          <p class="gradient-text text-xl font-semibold">Sprunki</p>
          <span class="muted text-sm">{new Date().getFullYear()} · Music Sandbox</span>
        </div>
      </div>
      <p>
        {t.brand}
      </p>
      <div class="footer-social">
        <a href="https://twitter.com/sprunkigame" aria-label="Twitter">𝕏</a>
        <a href="https://www.youtube.com/results?search_query=sprunki" aria-label="YouTube">▶</a>
        <a href="https://t.me/share/url?url=https://sprunkigames.online" aria-label="Telegram">✈</a>
      </div>
    </div>

    <div class="footer-columns">
      <div>
        <p class="column-title">{t.columns.play}</p>
        <ul>
          <li><a href={`${prefix}/characters`}>{t.columns.characters}</a></li>
          <li><a href={`${prefix}/blog`}>{t.columns.blog}</a></li>
          <li><a href={`${prefix}/pricing`}>{t.columns.pricing}</a></li>
        </ul>
      </div>
      <div>
        <p class="column-title">{t.columns.support}</p>
        <ul>
          <li><a href={`${prefix}/privacy`}>{t.columns.privacy}</a></li>
          <li><a href={`${prefix}/terms-of-service`}>{t.columns.terms}</a></li>
          <li><a href={`${prefix}/contact`}>{t.columns.contact}</a></li>
          <li><a href={`${prefix}/about`}>{t.columns.about}</a></li>
        </ul>
      </div>
      <div>
        <p class="column-title">{t.columns.network}</p>
        <ul>
          <li><a href="https://24kwebgames.com" target="_blank" rel="noopener">24k Web Games</a></li>
          <li><a href="https://rivalscodes.com" target="_blank" rel="noopener">Rivals Codes</a></li>
          <li><a href="https://stoiclines.store" target="_blank" rel="noopener">Stoic Lines</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Sprunki Games. All rights reserved.</p>
    <p>
      Crafted by <a href="https://sprunkigames.online" target="_blank" rel="noopener">SprunkiGames.online</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding: clamp(2rem, 5vw, 4rem) 0 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 2rem;
  }

  .footer-brand .logo {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .footer-brand img {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    width: 64px;
    height: 64px;
  }

  .footer-brand p {
    color: var(--text-secondary);
    max-width: 320px;
  }

  .footer-social {
    display: flex;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .footer-social a {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .footer-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
  }

  .column-title {
    font-weight: 600;
    margin-bottom: 1rem;
    font-size: 1.1rem;
    color: var(--text-heading);
  }

  .footer-columns ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-columns a {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 1rem;
    padding: 0.4rem 0;
    transition: var(--transition-base);
  }

  .footer-columns a:hover {
    color: var(--text-primary);
    padding-left: 0.25rem;
  }

  .footer-bottom {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--text-secondary);
    font-size: 0.9rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-bottom a {
    color: #fff;
    text-decoration: none;
  }
</style>
