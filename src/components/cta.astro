<section class="cta-section">
  <div class="cta-shell glass-panel">
    <div>
      <p class="pill">Ready to mix?</p>
      <h2>Plug in. Remix. Drop the beat.</h2>
      <p>Create Your Sound. Anytime. Anywhere.</p>
    </div>
    <div class="cta-actions">
      <a href="https://sprunkigames.online" class="neon-button">Launch Game Hub</a>
      <a href="/blog" class="ghost-link">Browse updates →</a>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: clamp(4rem, 8vw, 6rem) 0;
    background: linear-gradient(180deg, 
      rgba(15, 15, 25, 0.3) 0%,
      rgba(108, 93, 211, 0.1) 50%,
      rgba(15, 15, 25, 0.3) 100%
    );
    position: relative;
    overflow: hidden;
  }

  .cta-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, 
      transparent, 
      rgba(139, 92, 246, 0.4), 
      rgba(0, 224, 255, 0.4), 
      rgba(139, 92, 246, 0.4), 
      transparent
    );
  }

  .cta-shell {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3rem);
    background: linear-gradient(135deg, 
      rgba(22, 22, 35, 0.9) 0%, 
      rgba(15, 15, 25, 0.95) 100%
    );
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 24px;
    position: relative;
    overflow: hidden;
  }

  .cta-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 24px;
    padding: 1px;
    background: linear-gradient(135deg, 
      rgba(0, 224, 255, 0.2), 
      rgba(139, 92, 246, 0.3), 
      rgba(108, 93, 211, 0.2)
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  .cta-shell h2 {
    font-size: clamp(1.8rem, 4vw, 2.8rem);
    margin: 0.5rem 0 0.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, #fff 0%, #e0e0ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.2;
  }

  .cta-shell p {
    color: rgba(255, 255, 255, 0.6);
    max-width: 30rem;
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    line-height: 1.6;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    justify-content: center;
    position: relative;
    z-index: 1;
  }

  .ghost-link {
    color: var(--accent-cyan);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: gap 0.3s ease;
  }

  .ghost-link:hover {
    gap: 0.6rem;
  }
</style>
